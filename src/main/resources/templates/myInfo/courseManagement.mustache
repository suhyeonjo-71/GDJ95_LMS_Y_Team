<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>사용자 권한 관리 | 학사관리시스템</title>
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #F5F7FA;
        }
        .admin-hero-bg {
            background-image: linear-gradient(to right, rgba(37, 99, 235, 0.9), rgba(30, 64, 175, 0.8)), url('https://images.unsplash.com/photo-1562774053-701939374585?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
        }
        .input-readonly {
            background-color: #F8F9FA;
            border-color: #E5E7EB;
            color: #6B7280;
            cursor: default;
        }
        .modal-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 50;
        }
    </style>
</head>
<body class="text-gray-800">

<header class="bg-white border-b border-gray-200">
    <div class="max-w-screen-2xl mx-auto py-3 px-6 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white">
                <i class="fa-solid fa-graduation-cap text-lg"></i>
            </div>
            <h1 class="text-lg font-bold text-gray-800">
                <a href="/main" class="text-gray-800 hover:text-blue-600 transition">
                    학사관리시스템
                </a>
                <span class="text-sm font-medium text-gray-500 ml-1">나의 정보 페이지</span>
            </h1>
        </div>
        <div class="text-sm text-gray-600 flex items-center gap-4">
            <p>{{loginUserName}}님 로그인 중입니다</p>
            <a href="/logout" class="text-red-500 hover:text-red-600 transition flex items-center gap-1">
                <i class="fa-solid fa-right-from-bracket text-xs"></i> 로그아웃
            </a>
        </div>
    </div>
	</header>

    <div class="admin-hero-bg h-40 p-8 text-white">
        <div class="max-w-screen-2xl mx-auto h-full flex flex-col justify-end">
            <h2 class="text-3xl font-bold">학점 관리</h2>
            <p class="text-sm text-gray-200 mt-2">수강한 강의 및 학점 조회</p>
        </div>
    </div>

    <div class="flex min-h-[calc(100vh-16rem)]">

    <aside class="w-64 bg-white border-r border-gray-200 shadow-md flex-shrink-0">
        <nav class="p-4 space-y-1">
            <a href="/myInfo/userInfo" class="flex items-center gap-3 p-3 rounded-lg text-gray-600 hover:bg-gray-50 transition">
                <i class="fa-solid fa-user-gear w-5"></i> 개인정보 관리
            </a>
            <a href="/myInfo/courseManagement" class="flex items-center gap-3 p-3 rounded-lg bg-blue-50 text-blue-700 font-semibold transition">
                <i class="fa-solid fa-graduation-cap w-5"></i> 학점 관리
                <i class="fa-solid fa-chevron-right ml-auto text-xs"></i>
            </a>
        </nav>
    </aside>

    <main class="flex-grow bg-gray-100"> 
        <div id="initial-data" 
             data-total-pages="{{totalPages}}" 
             data-current-page="{{currentPage}}" 
             data-total-count="{{totalCount}}"
             data-search-condition="{{searchCourseCondition}}"
             data-selected-semester="{{selectedCourseYearAndSemester}}"
             class="hidden">
        </div>

        <div class="p-8 max-w-screen-2xl mx-auto"> 
            
            <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
                
                <h2 class="text-2xl font-bold text-gray-800 mb-2">🎓 나의 강의/학점 조회</h2>
                <p class="text-gray-500 mb-6">수강했던 강의 목록 및 개인별 학점 정보를 조회할 수 있습니다.</p>

                <form id="searchForm" action="" class="mb-8 p-4 border rounded-lg bg-gray-50">
                    <h3 class="text-lg font-semibold text-gray-700 mb-2">강의 검색</h3>
                    <p class="text-sm text-gray-500 mb-3">강의명, 교수명 등으로 검색할 수 있습니다.</p>
                    
                    <div class="flex items-center gap-2">
                        
                        <div class="flex-shrink-0">
                            <select id="courseYearSemesterSelect" 
                                    name="selectedCourseYearAndSemester" 
                                    class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 text-sm">
                                
                                <option value="" {{^selectedCourseYearAndSemester}}selected{{/selectedCourseYearAndSemester}}>전체 연도/학기</option>
                                
                                {{#selectCourseYearSemesterList}}
                                <option value="{{courseYearSemester}}" 
                                        {{#isSelected}}selected{{/isSelected}}>
                                    {{courseYearSemester}}
                                </option>
                                {{/selectCourseYearSemesterList}}
                            </select>
                        </div>
                        
                        <div class="flex-grow">
                            <input type="text"
                                   id="searchInput"
                                   name="searchCourseCondition"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 text-sm"
                                   placeholder="강의명, 교수명 검색"
                                   value="{{searchCourseCondition}}">
                        </div>
                        
                        <button type="button" id="searchButton" class="px-3 py-1.5 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-1">
                            <i class="fa-solid fa-magnifying-glass"></i> 조회
                        </button>
                    </div>
                </form>

                <div class="flex justify-between items-center mb-4">
                    <p class="text-gray-700 font-medium" id="totalCountDisplay">강의 목록 (총 {{totalCount}}개의 강의)</p>
                    <div class="flex space-x-2">
                        <button id="excelDownloadButton" class="px-3 py-1.5 text-sm bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
                            <i class="fa-solid fa-file-excel mr-1"></i> 목록 엑셀 다운로드
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto border border-gray-200 rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-10">No.</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">강의번호</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-20">개설년도</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">학기</th>
                                
                                <th class="p-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">학과명</th> 
                                <th class="p-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">강의명</th> 
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-20">교수이름</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-20">개설일</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">이수학점</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">평가점수</th>
                                <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">평가등급</th>
                                </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200" id="courseListBody">
                            {{#courseList}}
                            <tr class="hover:bg-gray-50">
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">{{rownm}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center">
                                    <button type="button" data-course-no="{{courseNo}}" class="text-blue-600 hover:text-blue-800 detail-link text-sm border-none bg-transparent p-0">
                                        {{courseNo}}
                                    </button>
                                </td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">{{courseYear}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">{{courseSemester}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-left text-sm text-gray-800">{{deptName}}</td>
                                <td class="px-3 py-2 text-sm text-gray-900 font-medium">{{courseName}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">{{professorUserName}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">{{createdate}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">{{courseScore}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">{{gradeFinalScore}}</td>
                                <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">{{gradeValue}}</td>
                            </tr>
                            {{/courseList}}
                            {{^courseList}}
                            <tr>
                                <td colspan="11" class="p-4 text-center text-gray-500 text-sm">조회된 강의/학점 정보가 없습니다.</td>
                            </tr>
                            {{/courseList}}
                        </tbody>
                    </table>
                </div>

                <div class="flex justify-center items-center mt-6" id="paginationArea">
                     {{! JavaScript가 여기에 페이징 컨트롤을 동적으로 렌더링합니다. }}
                </div>
            </div>
        </div>
        
        <div id="course-detail-modal" class="fixed inset-0 z-50 overflow-y-auto bg-gray-900 bg-opacity-50 hidden">
            <div class="flex items-center justify-center min-h-screen p-4">
                <div class="bg-white rounded-lg shadow-xl w-full max-w-lg p-6">
                    <div class="flex justify-between items-center pb-3 border-b border-gray-200 mb-4">
                        <h2 class="text-2xl font-bold text-gray-900">강의 상세 정보</h2>
                        <button type="button" class="px-3 py-1.5 text-sm text-gray-500 hover:text-gray-900" id="close-modal-btn">
                            <i class="fa-solid fa-xmark fa-lg"></i>
                        </button>
                    </div>

                    <div id="course-detail-content" class="text-gray-700">
                        <p>세부 정보를 로드 중입니다...</p>
                    </div>
                    
                    <div class="flex justify-end pt-4 border-t border-gray-200 mt-4">
                        <button type="button" class="px-3 py-1.5 text-sm bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition" id="close-modal-footer-btn">
                            닫기
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<footer class="max-w-7xl mx-auto px-4 py-8 text-center text-xs text-gray-400">
        	<p>&copy; 2025 SEMI- Y 학사관리시스템. All rights reserved.</p>
        	<p class="mt-1">본 시스템은 학사 업무의 효율적 관리를 위해 제작되었습니다.</p>
</footer>

  <script>
    $(document).ready(function() {
        // --- [환경 설정 및 초기 데이터 로드] ---
        // 현재 경로에 따라 관리자/학생 모드를 결정합니다.
        const isAdmin = window.location.pathname.includes('/admin/courseManagement');
        // AJAX 검색 URL도 isAdmin에 따라 결정됩니다. (컨트롤러와 일치)
        const searchUrl = isAdmin ? '/searchCourseInfoByAdmin' : '/searchCourseInfoByStudt'; 
        // 테이블의 컬럼 개수를 동적으로 설정합니다.
        // 관리자: 12개 (학생성명 포함), 학생: 11개 (학생성명 제외)
        const COL_COUNT = isAdmin ? 12 : 11;
        
        const initialTotalPages = parseInt($('#initial-data').data('total-pages') || '1', 10);
        const initialTotalCount = parseInt($('#initial-data').data('total-count') || '0', 10);
        const initialCurrentPage = parseInt($('#initial-data').data('current-page') || '1', 10);
        
        // ----------------------------------------------------------------
        // 2. 페이징 렌더링 함수 (유지)
        // ----------------------------------------------------------------
        function renderPagination(currentPage, totalPages, totalCount) {
            const container = $('#paginationArea');
            $('#totalCountDisplay').text(`강의 목록 (총 ${totalCount}개의 강의)`); 

            if (totalPages <= 1) {
                container.empty(); 
                return;
            }
            
            let html = '<nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">';
            // 이전 버튼
            if (currentPage > 1) {
                html += `<button type="button" data-page="${currentPage - 1}" class="page-link relative inline-flex items-center px-3 py-1.5 text-sm rounded-l-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">이전</button>`;
            } else {
                html += `<span class="relative inline-flex items-center px-3 py-1.5 text-sm rounded-l-md border border-gray-300 bg-gray-100 text-gray-400">이전</span>`;
            }
            // 페이지 번호
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);
            for (let i = startPage; i <= endPage; i++) {
                const activeClass = i === currentPage ? 'bg-indigo-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-50';
                html += `<button type="button" data-page="${i}" class="page-link relative inline-flex items-center px-4 py-1.5 text-sm border border-gray-300 font-medium ${activeClass}">${i}</button>`;
            }
            // 다음 버튼
            if (currentPage < totalPages) {
                html += `<button type="button" data-page="${currentPage + 1}" class="page-link relative inline-flex items-center px-3 py-1.5 text-sm rounded-r-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">다음</button>`;
            } else {
                 html += `<span class="relative inline-flex items-center px-3 py-1.5 text-sm rounded-r-md border border-gray-300 bg-gray-100 text-gray-400">다음</span>`;
            }

            html += '</nav>';
            container.html(html);
        }

     // ----------------------------------------------------------------
     // 3. 리스트 갱신 함수 (학생 필드 조건부 렌더링 적용)
     // ----------------------------------------------------------------
     function updateCourseList(list) {
         const $tbody = $('#courseListBody');
         
         $tbody.empty(); 
         let htmlArray = [];
         
         if (list && list.length > 0) {
             list.forEach((course) => {
                 const score = course.courseScore !== undefined ? course.courseScore : 'N/A';
                 
                 // 학생성명 필드 (관리자일 경우에만 출력)
                 const studentNameCell = isAdmin 
                     ? `<td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">${course.studentUserName || 'N/A'}</td>` 
                     : '';
                 
                 htmlArray.push(`
                     <tr class="hover:bg-gray-50">
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">${course.rownm || 'N/A'}</td>
                         
                         <td class="px-3 py-2 whitespace-nowrap text-center">
                             <button type="button" data-course-no="${course.courseNo}" class="text-blue-600 hover:text-blue-800 detail-link text-sm border-none bg-transparent p-0">
                                 ${course.courseNo} 
                             </button>
                         </td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">${course.courseYear}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">${course.courseSemester}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-left text-sm text-gray-800">${course.deptName}</td>
                         <td class="px-3 py-2 text-sm text-gray-900 font-medium">${course.courseName}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">${course.professorUserName}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">${course.createdate || 'N/A'}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-500">${score}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">${course.gradeFinalScore || 'N/A'}</td>
                         <td class="px-3 py-2 whitespace-nowrap text-center text-sm text-gray-800">${course.gradeValue || 'N/A'}</td>
                         ${studentNameCell}
                     </tr>
                 `);
             });
             
             $tbody.append(htmlArray.join(''));

         } else {
             // 데이터가 없는 경우, 동적으로 계산된 COL_COUNT를 사용합니다.
             $tbody.html(`<tr><td colspan="${COL_COUNT}" class="p-4 text-center text-gray-500 text-sm">조회된 강의/학점 정보가 없습니다.</td></tr>`);
         }
     }

  // ----------------------------------------------------------------
  // 4. 검색 및 페이지 요청 핸들러 (AJAX 호출)
  // ----------------------------------------------------------------
  function fetchCourseList(pageNo) {
      
      const searchCourseCondition = $('#searchInput').val();
      const selectedCourseYearAndSemester = $('#courseYearSemesterSelect').val();
      
      $.ajax({
          url: searchUrl,
          type: 'GET',
          data: {
              currentPage: pageNo,
              searchCourseCondition: searchCourseCondition,
              selectedCourseYearAndSemester: selectedCourseYearAndSemester
          },
          success: function(response) {
              if (response.status === 'success') {
                  const list = response.searchList || [];
                  const totalCount = response.totalCount || 0;
                  const totalPages = response.totalPages || 1;
                  const currentPage = response.currentPage || pageNo;

                  updateCourseList(list); 
                  renderPagination(currentPage, totalPages, totalCount);
                  
              } else if (response.status === 'student' || response.status === 'admin') {
                   // 컨트롤러에서 권한이 맞지 않을 때 던지는 에러 메시지를 alert으로 표시
                   alert(response.message); 
                   updateCourseList([]);
                   renderPagination(1, 1, 0);
              } else {
                  alert(response.message || '강의 정보를 불러오는 데 실패했습니다.');
                  updateCourseList([]); 
                  renderPagination(1, 1, 0);
              }
          },
          error: function(xhr) {
              alert('강의 목록을 불러오는 중 오류가 발생했습니다. 서버 연결 상태를 확인하십시오.');
              console.error('AJAX Error:', xhr);
              updateCourseList([]);
              renderPagination(1, 1, 0);
          }
      });
  }

        // ----------------------------------------------------------------
        // 5. 이벤트 바인딩 (최종 안정화)
        // ----------------------------------------------------------------

        // 5-1. 검색 폼 제출 이벤트 (유지)
        $('#searchForm').on('submit', function(e) {
            e.preventDefault(); 
            e.stopImmediatePropagation(); 
            fetchCourseList(1); 
        });
        
        // 5-2. 검색 버튼 클릭 이벤트 (유지)
        $('#searchButton').on('click', function(e) {
             e.preventDefault(); 
             e.stopImmediatePropagation(); 
             fetchCourseList(1); 
        });
        
        // 5-3. 연도/학기 선택 변경 이벤트 (유지)
        $('#courseYearSemesterSelect').on('change', function() {
            fetchCourseList(1); 
        });

        // 5-4. 페이징 버튼 클릭 이벤트 (유지)
        $('#paginationArea').on('click', '.page-link', function(e) {
            e.preventDefault(); 
            e.stopImmediatePropagation(); 
            const page = $(this).data('page');
            fetchCourseList(page);
        });

        // 5-7. 목록 엑셀 다운로드 이벤트 (유지)
        $('#excelDownloadButton').on('click', function(e) {
             e.preventDefault();
             
             const searchCondition = $('#searchInput').val();
             const yearSemester = $('#courseYearSemesterSelect').val();
             
             // 검색 조건을 쿼리 파라미터로 포함하여 다운로드 URL로 이동
             const downloadUrl = '/downloadCourseList?' + 
                                 'searchCourseCondition=' + encodeURIComponent(searchCondition) + 
                                 '&selectedCourseYearAndSemester=' + encodeURIComponent(yearSemester);
             
             // 브라우저를 다운로드 URL로 이동시키면, 서버에서 응답 헤더를 통해 파일 다운로드가 시작됩니다.
             window.location.href = downloadUrl;
        });

        // 5-5. 상세 정보 조회 (모달) 이벤트 (유지)
        $(document).on('click', '.detail-link', function(e) {
            e.preventDefault(); 
            e.stopImmediatePropagation(); 
            const courseNo = $(this).data('course-no');
            
            // ... (모달 로직)
            $.ajax({
                url: '/getCourseDetailListByCourseNo', 
                type: 'GET',
                data: { courseNo: courseNo },
                success: function(response) {
                    if (response.status === 'success') {
                        const detail = response.courseList; 
                        const score = detail.courseScore !== undefined ? detail.courseScore : 'N/A';
                        
                        let html = `
                            <table class="min-w-full divide-y divide-gray-200 text-sm">
                                <tbody>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600 w-28">강의 번호</td><td>${detail.courseNo}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">강의명</td><td>${detail.courseName}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">담당 교수</td><td>${detail.professorUserName || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">교수 연락처</td><td>${detail.userPhone || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">개설 학과</td><td>${detail.deptName || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">이수 학점</td><td>${score}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">강의실</td><td>${detail.courseClassroom || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">개설 상태</td><td>${detail.courseStatusName || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600">개설일자</td><td>${detail.createdate || 'N/A'}</td></tr>
                                    <tr class="border-b"><td class="py-2 pr-4 font-semibold text-gray-600 align-top">강의 설명</td><td class="whitespace-pre-wrap">${detail.courseDescription || '제공된 강의 설명이 없습니다.'}</td></tr>
                                </tbody>
                            </table>
                        `;
                        $('#course-detail-content').html(html); 
                        $('#course-detail-modal').removeClass('hidden'); 
                    } else {
                        alert(response.message || '세부 정보를 불러오는 데 실패했습니다.');
                    }
                },
                error: function() {
                    alert('세부 정보를 불러오는 중 오류가 발생했습니다.');
                }
            });
        });
        
        // 5-6. 모달 닫기 (유지)
        $('#close-modal-btn').on('click', function() {
            $('#course-detail-modal').addClass('hidden');
        });
        $('#close-modal-footer-btn').on('click', function() { 
            $('#course-detail-modal').addClass('hidden');
        });
        
        // 6. 초기 로드 시 페이징 렌더링 (유지)
        renderPagination(initialCurrentPage, initialTotalPages, initialTotalCount);
    });
</script>
</body>
</html>