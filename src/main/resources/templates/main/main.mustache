<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>학사관리시스템 | Academic Management System</title>
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- 메인페이지 캘린더 동적으로 사용하기 위한 LIB -->
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.css' rel='stylesheet' />
	<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
	<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales-all.global.min.js'></script>
    
    <style>
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #F5F7FA;
        }
        .hero-bg {
            background-image: linear-gradient(to right, rgba(37, 99, 235, 0.9), rgba(30, 64, 175, 0.8)), url('https://images.unsplash.com/photo-1562774053-701939374585?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
    </style>
    
    <!-- 캘린더 스타일추가 -->
	<style>
        /* Pretendard 폰트 설정 (Tailwind 기본 폰트 재정의) */
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #f7f7f9;
        }

        /* ----------------------------------------------------- */
        /* 캘린더 스타일 (사용자 요청 반영) */
        /* ----------------------------------------------------- */
        
        /* 1. 폰트 및 기본 스타일 조정 */
        /* 둥글고 친화적인 폰트 적용 */
        #academicCalendar, .fc-header-toolbar, #calendarTitle {
            font-family: Pretendard, 'Apple SD Gothic Neo', 'Malgun Gothic', '맑은 고딕', Dotum, '돋움', sans-serif !important;
        }
        
        /* 캘린더 컨테이너 최소 높이 보장 (달력이 안 보이는 문제 해결) */
        #academicCalendar {
            min-height: 350px; 
            width: 100%;
        }

        /* 캘린더 날짜 셀의 높이 조정 (이벤트가 잘 보이도록) */
        #academicCalendar .fc-daygrid-day {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            height: 100px; /* 고정 높이 */
            vertical-align: top; /* 내용을 위쪽으로 정렬 */
        }
        
        /* 2. 그리드 테두리 스타일링 */
        
        /* 캘린더 전체 Border 제거 (투박한 바깥쪽 테두리 제거) */
        #academicCalendar .fc-daygrid-container,
        #academicCalendar .fc-scrollgrid {
            border: none !important;
        }
        
        /* 요일 헤더가 숨겨져 있으므로, 그리드 상단의 불필요한 테두리 제거 */
        #academicCalendar .fc-daygrid-day-top {
            border-top: none !important;
        }
        
        /* 날짜 셀의 오른쪽/아래쪽 테두리 스타일을 얇고 연한 색으로 통일 */
        #academicCalendar .fc-daygrid-day {
            border-right: 1px solid #E5E7EB; /* border-gray-200 */
            border-bottom: 1px solid #E5E7EB; /* border-gray-200 */
        }
        
        /* 맨 왼쪽 날짜 셀의 왼쪽 테두리 추가 (테이블 전체 틀 유지) */
        #academicCalendar .fc-daygrid-body table {
            border-left: 1px solid #E5E7EB;
        }
        
        /* 마지막 행의 아래쪽 테두리 스타일 제거 (깔끔하게 마무리) */
        #academicCalendar .fc-daygrid-body tr:last-child .fc-daygrid-day {
            border-bottom: none !important;
        }
        
        /* 3. 날짜 및 주말 색상 조정 (공휴일 스타일 추가) */
        .fc-daygrid-day-number {
            font-weight: 500;
            font-size: 0.9rem;
            color: #4B5563; 
        }
        
        /* 🚩 일요일 날짜 (숫자) 색상: 빨강 */
        .fc-day-sun .fc-daygrid-day-number {
            color: #EF4444 !important; /* red-500 */
        }
        /* 🟦 토요일 날짜 (숫자) 색상: 파랑 */
        .fc-day-sat .fc-daygrid-day-number {
            color: #3B82F6 !important; /* blue-600 */
        }

        /* 🔴 공휴일 날짜 텍스트를 빨간색으로 지정 */
        .holiday-date .fc-daygrid-day-number {
            color: #EF4444 !important; /* red-500 */
            font-weight: 700 !important; /* 공휴일은 더욱 강조 */
        }
        
        /* 오늘 날짜 강조 스타일 */
        #academicCalendar .fc-day-today {
            background-color: #EFF6FF !important; /* blue-50 */
            border: 1px solid #60A5FA !important; /* blue-400 */
            border-radius: 0.5rem;
        }
        
        /* 4. 공휴일 및 학사 일정 이벤트 스타일 */
        #academicCalendar .fc-event {
            border-radius: 0.25rem;
            font-size: 0.7rem;
            padding: 0 0.2rem;
            line-height: 1.25;
            white-space: normal;
            font-weight: 600;
            cursor: pointer; 
            border: none !important; /* 이벤트 자체 테두리 제거 */
        }
        
        /* 🔴 공휴일 이벤트 스타일 (빨간색 배경/글자) */
        .holiday-event {
            border: none !important;
        }
        
        /* 5. 기타 그리드 스타일 */
        #academicCalendar .fc-daygrid-body {
            padding-top: 5px; 
        }
        #academicCalendar .fc-daygrid-body table {
            height: auto !important;
        }
        
        /* 날짜 셀에 커서 포인터 적용 (클릭 가능 시각적 표시) */
        #academicCalendar .fc-daygrid-day-frame {
            cursor: pointer;
        }
        
        /* 🔴 선택된 날짜 스타일 */
        #academicCalendar .selected-day {
            /* 기존 오늘 날짜와 구분되도록 다른 색상 사용 */
            background-color: #E0F2FE !important; /* light-blue-100 */
            border: 1px solid #0EA5E9 !important; /* sky-500 */
            border-radius: 0.5rem;
        }

        /* 캘린더 날짜 숫자 컨테이너 스타일링 (dayCellContent와 연동) */
        .fc-daygrid-day-number > span {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 1.75rem; /* w-7 */
            height: 1.75rem; /* h-7 */
            margin: 0 auto; /* mx-auto */
            border-radius: 9999px;
            margin-bottom: 4px; /* 날짜 숫자 아래에 여백 추가 */
        }
        
        /* 선택된 날짜의 날짜 숫자 자체에 선택 표시 */
        #academicCalendar .selected-day .fc-daygrid-day-number > span {
            background-color: #bfdbfe; /* blue-200 */
            color: #1d4ed8; /* blue-700 */
            font-weight: 700;
        }
        
        /* 스크롤바 커스터마이징 */
        .custom-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1; /* gray-300 */
            border-radius: 9999px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background-color: #f8f8f8;
        }
    </style>
    
</head>
