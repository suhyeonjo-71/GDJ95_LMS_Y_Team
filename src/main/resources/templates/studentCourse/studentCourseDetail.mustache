<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>강의 상세 | 학사관리시스템</title>

    <!-- Pretendard -->
    <link rel="stylesheet" as="style" crossorigin 
          href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    
    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Fontawesome -->
    <link rel="stylesheet" 
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

    <!-- 공통 스타일(main.mustache와 동일 톤 적용) -->
    <style>
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #F5F7FA;
        }

        /* 공통 카드 스타일 */
        .info-card {
            background: white;
            border: 1px solid #E5E7EB; /* border-gray-200 */
            border-radius: 1rem;        /* rounded-xl */
            box-shadow: 0 4px 6px rgba(0,0,0,0.03);
        }

        /* 세부 텍스트 스타일 통일 */
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1f2937; /* text-gray-800 */
        }

        .section-icon {
            color: #2563eb; /* blue-600 */
        }
    </style>
</head>

<body class="text-gray-800">

    {{> studentLayout/studentPageHeader }}

    <main class="max-w-5xl mx-auto px-4 py-10">

        <!-- ============================ -->
        <!-- 강의 기본 정보 카드 -->
        <!-- ============================ -->
        <section class="info-card p-8 mb-10">
            
            <p class="text-xs font-semibold text-blue-600 mb-1 flex items-center gap-1">
                <i class="fa-solid fa-book-open"></i>
                강의 정보
            </p>

            <h1 class="text-3xl font-bold mb-6 text-gray-800">
                {{course.courseName}}
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700">

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-user-tie text-blue-600 w-5"></i>
                    <span><b>담당 교수:</b> {{course.professorName}}</span>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-layer-group text-purple-600 w-5"></i>
                    <span><b>학과:</b> {{course.deptName}}</span>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-coins text-yellow-500 w-5"></i>
                    <span><b>학점:</b> {{course.courseScore}} 학점</span>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-location-dot text-red-500 w-5"></i>
                    <span><b>강의실:</b> {{course.courseClassroom}}</span>
                </div>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-700 mt-6">

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-users text-indigo-600 w-5"></i>
                    <span><b>정원:</b> {{course.courseCapacity}}명</span>
                </div>

                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-user-check text-green-600 w-5"></i>
                    <span><b>현재 신청 인원:</b> {{course.currentCount}}명</span>
                </div>

            </div>

        </section>

        <!-- ============================ -->
        <!-- 수업 시간 -->
        <!-- ============================ -->
        <section class="info-card p-8 mb-10">

            <h2 class="section-title mb-3 flex items-center gap-2">
                <i class="fa-regular fa-calendar-days section-icon"></i>
                수업 시간
            </h2>

            {{#course.courseTimeList}}
            <p class="text-sm text-gray-700 flex items-center gap-2 mb-1">
                <i class="fa-solid fa-clock text-gray-500"></i>
                {{yoilName}}요일 · {{courseTimeStart}}교시 ~ {{courseTimeEnd}}교시
            </p>
            {{/course.courseTimeList}}

            {{^course.courseTimeList}}
            <p class="text-xs text-gray-400">등록된 수업 시간이 없습니다.</p>
            {{/course.courseTimeList}}

        </section>

        <!-- ============================ -->
        <!-- 강의 소개 -->
        <!-- ============================ -->
        <section class="info-card p-8 mb-10">

            <h2 class="section-title mb-3 flex items-center gap-2">
                <i class="fa-solid fa-file-lines section-icon"></i>
                강의 소개
            </h2>

            <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed">
                {{course.courseDescription}}
            </p>

        </section>

    </main>

    {{> studentLayout/studentFooter }}

</body>
</html>
