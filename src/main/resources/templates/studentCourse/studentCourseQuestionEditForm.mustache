<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>문의 수정</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; background:#F5F7FA; color:#333; }
        .card {
            background:#fff; border-radius:12px; padding:30px; margin-bottom:20px;
            border:1px solid #E5E7EB; box-shadow:0 4px 20px rgba(30,64,175,0.12);
        }
        .page-title { font-size:22px; font-weight:800; color:#1E3A8A; }
    </style>
</head>

<body>

{{> studentLayout/studentCoursePageHeader }}

<div class="mt-8 w-full">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

    <div class="card">

        <h1 class="page-title flex items-center gap-2 mb-6">
            <i class="fa-solid fa-pen-to-square text-blue-600"></i>
            문의 수정
        </h1>

        <form action="/studentCourseQuestionEdit" method="post" class="space-y-6">

            <input type="hidden" name="courseQuestionNo" value="{{question.courseQuestionNo}}">
            <input type="hidden" name="courseNo" value="{{question.courseNo}}">

            <!-- Title -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">제목</label>
                <input type="text"
                       name="courseQuestionTitle"
                       value="{{question.courseQuestionTitle}}"
                       required
                       class="w-full border border-gray-300 rounded-lg text-sm p-3
                              focus:ring-blue-500 focus:border-blue-500" />
            </div>

            <!-- Content -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">내용</label>
                <textarea name="courseQuestionContent" rows="6" required
                          class="w-full border border-gray-300 rounded-lg text-sm p-3
                                 focus:ring-blue-500 focus:border-blue-500">{{question.courseQuestionContent}}</textarea>
            </div>

            <!-- Private -->
			<div class="flex items-center gap-2 text-sm">
			
			    <!-- 체크 안됐을 때 0 이 전송되도록 hidden 먼저 전달 -->
			    <input type="hidden" name="privatePost" value="0">
			
			    <!-- 체크되면 value=1 이 전송됨 -->
			    <input type="checkbox"
			           name="privatePost"
			           value="1"
			           class="w-4 h-4"
			           {{#question.privatePostFlag}}checked{{/question.privatePostFlag}}>
			    <span>비밀글로 설정</span>
			</div>

            <!-- Buttons -->
            <div class="flex justify-end gap-3 pt-4">
                <a href="/studentCourseQuestionDetail?courseQuestionNo={{question.courseQuestionNo}}"
                   class="px-4 py-2 rounded-lg border border-gray-300 text-sm text-gray-600 hover:bg-gray-50">
                    취소
                </a>

                <button class="px-5 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700">
                    수정완료
                </button>
            </div>

        </form>

    </div>

</main>

</body>
</html>
