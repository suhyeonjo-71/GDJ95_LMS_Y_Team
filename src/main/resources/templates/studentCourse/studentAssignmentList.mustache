<!-- 학생 과제 목록 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>과제 목록 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
/* ============================================
   RESET & GLOBAL
============================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: 'Pretendard', sans-serif;
    background-color: #F5F7FA;
    color: #333;
}

/* ============================================
   CARD — Smart Blue UI
============================================ */
.card {
    background-color: #FFFFFF;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(30, 64, 175, 0.12);
    border: 1px solid #E5E7EB;
}

/* ============================================
   TABLE-LIST 스타일
============================================ */
.list-item {
    padding: 16px 0;
}
.list-item:hover {
    background-color: #F9FAFB;
}
.badge-done {
    background-color: #D1FAE5;
    color: #047857;
}
.badge-not {
    background-color: #FEE2E2;
    color: #DC2626;
}

/* ============================================
   TEXT helper
============================================ */
.section-title {
    font-size: 22px;
    font-weight: 800;
    color: #1E3A8A;
}

/* ============================================
   SUB NAV WRAP FIX
============================================ */
.subnav-wrap {
    width: 100%;
    background: transparent;
}
    </style>
</head>

<body>

{{> studentLayout/studentCoursePageHeader }}

<!-- 서브 네비 - 수강신청 CSS와 동일한 max-w-6xl 적용 -->
<div class="mt-8 subnav-wrap">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

    <!-- 상단 타이틀 Card -->
    <div class="card mb-8">
        <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1 flex items-center gap-1">
            <i class="fa-solid fa-clipboard-list"></i>
            과제
        </p>

        <h1 class="section-title">과제 목록</h1>
        <p class="mt-1 text-xs text-gray-500">
            현재 수강 중인 강의의 과제를 확인하고 제출 상태를 확인할 수 있습니다.
        </p>
    </div>

    <!-- 리스트 card -->
    <div class="card">

        {{#assignmentList}}
        <ul class="divide-y divide-gray-200">

            {{#assignmentList}}
            <li class="list-item flex flex-col sm:flex-row sm:items-center justify-between gap-3">

                <!-- 제목 -->
                <div class="min-w-0">
                    <a href="/student/assignment/detail?assignmentNo={{assignmentNo}}&courseNo={{courseNo}}"
                       class="text-sm sm:text-base font-semibold text-gray-900 hover:text-blue-600 line-clamp-2">
                        {{assignmentTitle}}
                    </a>
                    <p class="mt-1 text-xs text-gray-500">
                        마감일: {{assignmentDeadline}}
                    </p>
                </div>

                <!-- 제출 상태 -->
                <div class="flex items-center gap-3 sm:ml-4">

                    {{#assignmentSubmitted}}
                    <span class="px-3 py-1 rounded-full badge-done text-xs font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-check"></i> 제출 완료
                    </span>
                    {{/assignmentSubmitted}}

                    {{^assignmentSubmitted}}
                    <span class="px-3 py-1 rounded-full badge-not text-xs font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-circle-exclamation"></i> 미제출
                    </span>
                    {{/assignmentSubmitted}}

                </div>

            </li>
            {{/assignmentList}}

        </ul>
        {{/assignmentList}}

        {{^assignmentList}}
        <div class="py-10 text-center text-sm text-gray-400">
            <i class="fa-regular fa-clipboard mb-2 block text-xl"></i>
            등록된 과제가 없습니다.
        </div>
        {{/assignmentList}}

    </div>

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
