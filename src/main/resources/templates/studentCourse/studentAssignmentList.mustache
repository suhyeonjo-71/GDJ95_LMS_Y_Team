<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>과제 목록 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; }

        .card {
            background: #ffffff;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(30, 64, 175, 0.10);
            border: 1px solid #E5E7EB;
        }

        .badge-done {
            background-color: #D1FAE5;
            color: #047857;
        }

        .badge-not {
            background-color: #FEE2E2;
            color: #DC2626;
        }
    </style>
</head>

<body class="bg-[#F5F7FA] text-gray-800">

{{> studentLayout/studentCoursePageHeader }}

<!-- 서브 네비 -->
<div class="mt-8 w-full">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

    <!-- 상단 카드 -->
    <div class="card mb-8">
        <div class="flex items-center gap-2 mb-2 text-blue-600 text-xs font-semibold uppercase tracking-wide">
            <i class="fa-solid fa-clipboard-list"></i>
            과제
        </div>

        <h1 class="text-2xl font-bold text-gray-900">과제 목록</h1>
        <p class="text-sm text-gray-500 mt-1">
            이 강의에서 제출해야 하는 모든 과제를 확인하세요.
        </p>
    </div>

    <!-- 리스트 카드 -->
    <div class="card">

        {{#assignmentList}}
        <ul class="divide-y divide-gray-200">

            {{#assignmentList}}
            <li class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">

                <!-- 제목 -->
                <div>
                    <a href="/student/assignment/detail?assignmentNo={{assignmentNo}}&courseNo={{courseNo}}"
                       class="font-semibold text-gray-900 hover:text-blue-600 text-sm sm:text-base">
                        {{assignmentTitle}}
                    </a>
                    <p class="text-xs text-gray-500 mt-1">마감일: {{assignmentDeadline}}</p>
                </div>

                <!-- 제출 상태 -->
                <div class="flex items-center gap-3">

                    {{#submitted}}
                    <span class="px-3 py-1 rounded-full text-xs font-semibold badge-done flex items-center gap-1">
                        <i class="fa-solid fa-check"></i> 제출 완료
                    </span>
                    {{/submitted}}

                    {{^submitted}}
                    <span class="px-3 py-1 rounded-full text-xs font-semibold badge-not flex items-center gap-1">
                        <i class="fa-solid fa-circle-exclamation"></i> 미제출
                    </span>
                    {{/submitted}}

                </div>

            </li>
            {{/assignmentList}}

        </ul>
        {{/assignmentList}}

        {{^assignmentList}}
        <div class="py-12 text-center text-gray-400 text-sm">
            <i class="fa-regular fa-clipboard text-xl mb-2"></i><br>
            등록된 과제가 없습니다.
        </div>
        {{/assignmentList}}

    </div>

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
