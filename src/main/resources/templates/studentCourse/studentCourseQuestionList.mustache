<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>강의 Q&A 목록</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
/* ============================================ */
* { margin:0; padding:0; box-sizing:border-box; }
body {
    font-family:'Pretendard', sans-serif;
    background-color:#F5F7FA;
    color:#333;
}

/* 카드 */
.card {
    background-color:#fff;
    border-radius:12px;
    padding:30px;
    margin-bottom:20px;
    box-shadow:0 4px 20px rgba(30,64,175,0.12);
}

/* 테이블 */
.table-wrap {
    border-radius:10px;
    overflow:hidden;
    border:1px solid #E5E7EB;
}
table { width:100%; border-collapse:collapse; }

thead th {
    background-color:#EFF6FF;
    color:#1E3A8A;
    padding:12px;
    border-bottom:2px solid #DBEAFE;
    font-weight:600;
    font-size:14px;
}
tbody td {
    padding:12px;
    border-bottom:1px solid #E5E7EB;
    font-size:14px;
}
tbody tr:hover {
    background-color:rgba(37,99,235,0.08);
    cursor:pointer;
}

/* 상태 배지 */
.badge {
    padding:3px 8px;
    border-radius:6px;
    font-size:12px;
    font-weight:600;
}
.badge-green { background:#E8FEEB; color:#1A7F37; }
.badge-red   { background:#FEECEC; color:#D11A2A; }

/* 페이징 */
.pagination-area a {
    padding:8px 12px;
    border-radius:6px;
    font-size:13px;
    border:1px solid #D1D5DB;
    background:white;
    margin:0 3px;
    transition:0.25s;
}
.pagination-area a:hover {
    background-color:#2563EB;
    color:white;
    border-color:#2563EB;
}
.active-page {
    background-color:#2563EB !important;
    color:white !important;
    border-color:#2563EB !important;
}
.nav-btn { background-color:#E5EFFE; }
.nav-btn:hover { background-color:#2563EB; color:white; }

/* 제목 */
.page-title {
    font-size:22px;
    font-weight:800;
    color:#1E3A8A;
}
</style>

</head>

<body>

{{> studentLayout/studentCoursePageHeader }}

<!-- 서브 네비 -->
<div class="mt-8 w-full">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

<!-- 카드 -->
<div class="card">

    <!-- 상단 제목 + 버튼 -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="page-title flex items-center gap-3">
            <i class="fa-solid fa-circle-question text-blue-600 text-xl"></i>
            강의 문의사항 목록
        </h2>

        <a href="/studentCourseQuestionWriteForm?courseNo={{courseNo}}"
           class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow text-sm flex items-center gap-2">
            <i class="fa-solid fa-pen"></i> 문의하기
        </a>
    </div>

    <!-- 리스트 -->
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th class="w-16">번호</th>
                <th>제목</th>
                <th class="w-28">작성자</th>
                <th class="w-40">작성일</th>
                <th class="w-24">상태</th>
            </tr>
            </thead>

            <tbody>

            {{#questionList}}
            <tr onclick="location.href='/studentCourseQuestionDetail?courseQuestionNo={{courseQuestionNo}}'">

                <!-- 번호 -->
                <td>{{index}}</td>

                <!-- 제목 -->
                <td>
                    {{#privatePost}}
                        <i class="fa-solid fa-lock text-gray-400 text-xs mr-1"></i>
                    {{/privatePost}}

                    {{#canView}}
                    <span class="hover:text-blue-600 font-medium">
                        {{courseQuestionTitle}}
                    </span>
                    {{/canView}}

                    {{^canView}}
                    <span class="text-gray-400">비밀글입니다.</span>
                    {{/canView}}
                </td>

                <!-- 작성자 -->
                <td>{{writerName}}</td>

                <!-- 작성일 -->
                <td class="text-sm text-gray-600">{{createdate}}</td>

                <!-- 상태 -->
                <td>
                    {{#answered}}
                    <span class="badge badge-green">답변완료</span>
                    {{/answered}}

                    {{^answered}}
                    <span class="badge badge-red">미답변</span>
                    {{/answered}}
                </td>

            </tr>
            {{/questionList}}

            {{^questionList}}
            <tr>
                <td colspan="5" class="text-center py-6 text-gray-500">
                    등록된 문의가 없습니다.
                </td>
            </tr>
            {{/questionList}}

            </tbody>
        </table>
    </div>

    <!-- 페이징 -->
    <div class="flex justify-center mt-8 pagination-area">

        {{#hasPrev}}
        <a class="nav-btn" href="?courseNo={{courseNo}}&currentPage=1">« 처음</a>
        <a class="nav-btn" href="?courseNo={{courseNo}}&currentPage={{prevPage}}">‹ 이전</a>
        {{/hasPrev}}

        {{#pageList}}
        <a href="?courseNo={{courseNo}}&currentPage={{page}}"
           class="{{#current}}active-page{{/current}}">
            {{page}}
        </a>
        {{/pageList}}

        {{#hasNext}}
        <a class="nav-btn" href="?courseNo={{courseNo}}&currentPage={{nextPage}}">다음 ›</a>
        <a class="nav-btn" href="?courseNo={{courseNo}}&currentPage={{lastPage}}">마지막 »</a>
        {{/hasNext}}

    </div>

</div>

</main>

</body>
</html>
