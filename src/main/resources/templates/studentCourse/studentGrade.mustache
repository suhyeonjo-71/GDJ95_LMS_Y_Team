<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>성적 확인 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; }
    </style>
</head>
<body class="bg-[#F5F7FA] text-gray-800">

{{> studentLayout/studentCoursePageHeader }}

<!-- 서브 네비 -->
<div class="mt-8 w-full">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

    {{#grade}}
    <!-- 성적 카드 -->
    <section class="bg-white rounded-3xl shadow-xl px-10 py-12 border border-gray-100 mb-10">

        <!-- 타이틀 -->
        <div class="flex items-center justify-between mb-10">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
                <i class="fa-solid fa-graduation-cap text-blue-600"></i>
                최종 성적
            </h2>
        </div>

        <!-- 메인 성적 표시 -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-8">

            <!-- 학점 원형 -->
            <div class="flex flex-col items-center">
                <div class="w-40 h-40 rounded-full bg-blue-50 border-4 border-blue-200 flex items-center justify-center shadow-inner">
                    <span class="text-5xl font-extrabold text-blue-600">{{gradeValue}}</span>
                </div>
                <p class="mt-3 text-sm text-gray-500">학점 등급</p>
            </div>

            <!-- 세부 정보 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 flex-1">

                <div class="p-5 rounded-2xl bg-gray-50 border border-gray-200 shadow-sm">
                    <p class="text-sm text-gray-500 mb-1">평점 (Score)</p>
                    <p class="text-2xl font-bold text-gray-900">{{gradeScore}}</p>
                </div>

                <!-- 추후 다른 지표가 생기면 여기에 추가 가능 -->
                <div class="p-5 rounded-2xl bg-gray-50 border border-gray-200 shadow-sm flex flex-col justify-center">
                    <p class="text-sm text-gray-500 mb-1">과목 번호</p>
                    <p class="text-xl font-semibold text-gray-800">{{courseNo}}</p>
                </div>

            </div>

        </div>

    </section>
    {{/grade}}

    {{^grade}}
    <div class="bg-white rounded-3xl shadow p-12 border border-gray-100 text-center">
        <i class="fa-regular fa-circle-question text-5xl text-gray-300 mb-4"></i>
        <p class="text-gray-500 text-lg">아직 성적이 입력되지 않았습니다.</p>
    </div>
    {{/grade}}

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
