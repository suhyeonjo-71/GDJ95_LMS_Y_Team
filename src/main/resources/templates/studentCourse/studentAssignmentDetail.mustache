<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>과제 상세 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; }
    </style>
</head>

<body class="bg-[#F5F7FA] text-gray-800">

{{> studentLayout/studentCoursePageHeader }}

<main class="max-w-4xl mx-auto px-4 py-10">

    <!-- 상단: 뒤로가기 버튼 -->
    <div class="mb-6 flex justify-start">
        <a href="/student/assignment/list?courseNo={{assignment.courseNo}}"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-lg
                  bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium
                  transition">
            <i class="fa-solid fa-arrow-left text-xs"></i>
            과제 목록으로 돌아가기
        </a>
    </div>

    <!-- ================================================================= -->
    <!-- 📌 과제 정보 영역 -->
    <!-- ================================================================= -->
    <section class="bg-white rounded-xl shadow-md p-8 mb-8 border border-gray-200">
        <h1 class="text-2xl font-bold text-gray-900 mb-3">
            {{assignment.assignmentTitle}}
        </h1>

        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-700 mb-4">
            <span class="inline-flex items-center gap-1">
                <span class="font-semibold">마감일</span>
                <span>:</span>
                <span>{{assignment.assignmentDeadline}}</span>
            </span>
        </div>

        <p class="text-sm text-gray-700 whitespace-pre-line mb-6">
            {{assignment.assignmentDescription}}
        </p>

        <!-- 제출 상태 -->
        {{#assignment.submitted}}
        <div class="text-sm text-green-600 font-medium mb-2">
            ✔ 이미 제출했습니다 ({{assignment.submittedDate}})
        </div>

        {{#assignment.assignmentSubmissionFileUrl}}
        <div class="text-sm">
            제출 파일 :
            <a href="{{assignment.assignmentSubmissionFileUrl}}"
               class="text-blue-600 underline ml-1"
               target="_blank">
                파일 열기
            </a>
        </div>
        {{/assignment.assignmentSubmissionFileUrl}}
        {{/assignment.submitted}}

        {{^assignment.submitted}}
        <div class="text-sm text-red-600 font-medium">
            ✘ 아직 제출하지 않았습니다
        </div>
        {{/assignment.submitted}}
    </section>

    <!-- ================================================================= -->
    <!-- 📌 제출 / 수정 영역 (마감 여부에 따라 제어) -->
    <!-- ================================================================= -->

    {{#assignment.deadlinePassed}}
    <!-- 마감 지난 경우: 안내만 -->
    <section class="bg-white rounded-xl shadow-md p-8 border border-gray-200 text-center">
        <h2 class="text-xl font-semibold text-gray-900 mb-3">
            제출 기간이 마감되었습니다
        </h2>
        <p class="text-sm text-gray-600">
            마감일 이후에는 과제를 제출하거나 수정할 수 없습니다.
        </p>
    </section>
    {{/assignment.deadlinePassed}}

    {{^assignment.deadlinePassed}}
    <!-- 마감 전: 제출/수정 가능 -->
    <section class="bg-white rounded-xl shadow-md p-8 border border-gray-200">

        <h2 class="text-xl font-semibold text-gray-900 mb-6">
            {{#assignment.submitted}}과제 수정하기{{/assignment.submitted}}
            {{^assignment.submitted}}과제 제출하기{{/assignment.submitted}}
        </h2>

        <form action="/student/assignment/submit"
              method="post"
              enctype="multipart/form-data"
              class="space-y-6">

            <input type="hidden" name="assignmentNo" value="{{assignment.assignmentNo}}">
            <input type="hidden" name="courseNo" value="{{assignment.courseNo}}">

            <!-- 내용 입력 -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    내용
                </label>
                <textarea name="content"
                          class="w-full border border-gray-300 rounded-lg p-3 h-40
                                 text-sm focus:ring-2 focus:ring-blue-400 focus:outline-none"
                          placeholder="여기에 과제 내용을 입력하세요">{{assignment.assignmentSubmissionContent}}</textarea>
            </div>

            <!-- 파일 업로드 -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                    파일 업로드
                </label>

                <input type="file" name="file"
                       class="block w-full text-sm text-gray-700 border border-gray-300
                              rounded-lg p-2">

                {{#assignment.assignmentSubmissionFileUrl}}
                <p class="mt-2 text-xs text-gray-600">
                    현재 제출된 파일 :
                    <a href="{{assignment.assignmentSubmissionFileUrl}}"
                       target="_blank"
                       class="text-blue-600 underline ml-1">
                        기존 제출 파일 보기
                    </a>
                </p>
                {{/assignment.assignmentSubmissionFileUrl}}
            </div>

            <!-- 제출 버튼 -->
            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg
                           text-sm font-semibold transition">
                {{#assignment.submitted}}수정하기{{/assignment.submitted}}
                {{^assignment.submitted}}제출하기{{/assignment.submitted}}
            </button>

        </form>
    </section>
    {{/assignment.deadlinePassed}}

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
