<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>공지 상세 | 학사관리시스템</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
/* 기본 설정 */
body {
    font-family: 'Pretendard', sans-serif;
    background:#F5F7FA;
}

/* 공통 카드 스타일 */
.card {
    background:white;
    border-radius:12px;
    padding:30px;
    margin-bottom:22px;
    border:1px solid #E5E7EB;
    box-shadow:0 4px 20px rgba(30,64,175,0.12);
}

/* 뒤로가기 버튼 */
.back-btn {
    background:#E5E7EB;
    padding:10px 16px;
    border-radius:8px;
    font-size:14px;
    color:#374151;
    transition:.25s;
}
.back-btn:hover {
    background:#d1d5db;
}

/* 제목 */
.notice-title {
    font-size:24px;
    font-weight:800;
    color:#1E3A8A;
}

/* 메타 정보 */
.meta-box span {
    display:flex;
    align-items:center;
    gap:6px;
    font-size:14px;
    color:#4B5563;
}
</style>
</head>

<body>

{{> studentLayout/studentCoursePageHeader }}

<!-- 서브 네비 -->
<div class="mt-8 w-full">
    <div class="max-w-6xl mx-auto px-4">
        {{> studentLayout/_studentCourseSubNav }}
    </div>
</div>

<main class="max-w-6xl mx-auto px-4 py-10">

    <!-- 공지 제목 + 메타 정보 -->
    <section class="card relative">

        <p class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-2">
            <i class="fa-solid fa-bullhorn mr-1"></i> 공지사항
        </p>

        <h1 class="notice-title mb-5">
            {{detail.courseNoticeTitle}}
        </h1>

        <div class="meta-box flex flex-wrap gap-6">
            <span><i class="fa-solid fa-hashtag text-gray-500"></i> 공지 번호: <b>{{detail.courseNoticeNo}}</b></span>
            <span><i class="fa-solid fa-user text-gray-500"></i> 작성자: <b>{{detail.writerUserName}}</b></span>
            <span><i class="fa-solid fa-calendar-days text-gray-500"></i> 등록일: {{detail.createdate}}</span>
        </div>

    </section>

    <!-- 공지 내용 -->
    <section class="card">
        <div class="whitespace-pre-line text-gray-800 leading-relaxed">
            {{detail.courseNoticeContent}}
        </div>
    </section>

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
