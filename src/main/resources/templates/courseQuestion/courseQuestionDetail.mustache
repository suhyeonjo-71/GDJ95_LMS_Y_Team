<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>문의 상세보기</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; }
    </style>
</head>

<body class="bg-[#F5F7FA] text-gray-800">

{{> studentLayout/studentCoursePageHeader }}

<main class="max-w-4xl mx-auto px-5 py-10">

    <!-- 뒤로가기 -->
    <div class="mb-4">
        <a href="/courseQuestionList?courseNo={{question.courseNo}}"
           class="text-sm text-gray-500 hover:text-gray-700">
            ← 목록으로 돌아가기
        </a>
    </div>

    <!-- 문의 카드 -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-7">

        <!-- 제목 + 상태 -->
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-xl font-semibold text-gray-900 flex items-center gap-2">

                {{#question.privatePost}}
                    <i class="fa-solid fa-lock text-gray-400 text-sm"></i>
                {{/question.privatePost}}

                {{#question.canView}}
                    {{question.courseQuestionTitle}}
                {{/question.canView}}

                {{^question.canView}}
                    비밀글입니다.
                {{/question.canView}}
            </h2>

            <div>
                {{#question.answered}}
                <span class="px-3 py-1 rounded-full bg-green-50 text-green-700 text-xs font-medium">
                    답변완료
                </span>
                {{/question.answered}}

                {{^question.answered}}
                <span class="px-3 py-1 rounded-full bg-yellow-50 text-yellow-700 text-xs font-medium">
                    미답변
                </span>
                {{/question.answered}}
            </div>
        </div>

        <!-- 작성자 / 날짜 -->
        <div class="text-xs text-gray-500 mb-6 flex items-center gap-4">
            <span><i class="fa-solid fa-user text-gray-400 mr-1"></i>{{question.writerName}}</span>
            <span><i class="fa-solid fa-clock text-gray-400 mr-1"></i>{{question.createdate}}</span>
        </div>

        <!-- 수정/삭제 버튼 (글 작성자만 가능) -->
        {{#isOwner}}
        <div class="flex justify-end gap-3 mb-4">
            <a href="/courseQuestionEditForm?courseQuestionNo={{question.courseQuestionNo}}"
               class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700">
                수정
            </a>

            <button onclick="openDeleteModal()"
                    class="px-4 py-2 bg-red-500 text-white rounded-lg text-sm hover:bg-red-600">
                삭제
            </button>
        </div>
        {{/isOwner}}

        <!-- 내용 -->
        <div class="text-gray-700 leading-relaxed text-sm whitespace-pre-line">

            {{#question.canView}}
                {{question.courseQuestionContent}}
            {{/question.canView}}

            {{^question.canView}}
                🔒 비밀글은 작성자와 담당 교수가 아니면 볼 수 없습니다.
            {{/question.canView}}

        </div>

    </div>

    <!-- 댓글 영역 -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-100 mt-8 p-7">

        <h3 class="text-lg font-semibold text-gray-800 mb-4">댓글</h3>

        <!-- 댓글 리스트 -->
        {{#question.answerList}}
        <div class="border-b py-4">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-gray-800">{{writerName}}</span>
                <span class="text-xs text-gray-400">{{createdate}}</span>
            </div>

            <p class="text-gray-700 text-sm mt-2 whitespace-pre-line">
                {{answerContent}}
            </p>

            <!-- 교수 본인 댓글 수정 -->
            {{#answerOwner}}
            <div class="flex justify-end mt-2">
                <a href="/courseQuestionAnswerEditForm?answerNo={{answerNo}}"
                   class="text-xs text-blue-600 hover:underline">
                    수정
                </a>
            </div>
            {{/answerOwner}}
        </div>
        {{/question.answerList}}

        {{^question.answerList}}
        <div class="py-6 text-center text-gray-400 text-sm">
            아직 댓글이 없습니다.
        </div>
        {{/question.answerList}}

        <!-- 댓글 작성 폼 (교수만 가능) -->
        {{#isProfessor}}
        <form action="/addAnswer" method="post" class="mt-6">
            <input type="hidden" name="courseQuestionNo" value="{{question.courseQuestionNo}}">

            <textarea name="answerContent"
                      class="w-full border rounded-lg p-3 text-sm h-32 focus:ring-blue-300 focus:ring"
                      placeholder="댓글을 입력하세요..." required></textarea>

            <button class="mt-3 px-5 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700">
                등록
            </button>
        </form>
        {{/isProfessor}}

        <!-- 학생에게는 안내 문구 -->
        {{^isProfessor}}
        <div class="mt-6 p-4 text-center text-gray-400 text-sm bg-gray-50 rounded-lg">
            댓글 작성은 교수만 가능합니다.
        </div>
        {{/isProfessor}}

    </div>

</main>

<!-- 삭제 모달 -->
<div id="deleteModal"
     class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50">

    <div class="bg-white rounded-xl shadow-xl p-6 max-w-sm w-full">
        <h3 class="text-lg font-semibold text-gray-900">삭제 확인</h3>
        <p class="text-sm text-gray-600 mt-3">
            정말 삭제하시겠습니까?<br>
            삭제된 글은 복구할 수 없습니다.
        </p>

        <div class="flex justify-end gap-3 mt-6">

            <button onclick="closeDeleteModal()"
                    class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
                취소
            </button>

            <button onclick="submitDelete({{question.courseQuestionNo}})"
                    class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                삭제하기
            </button>

        </div>
    </div>
</div>

<script>
function openDeleteModal() {
    document.getElementById("deleteModal").classList.remove("hidden");
}

function closeDeleteModal() {
    document.getElementById("deleteModal").classList.add("hidden");
}

function submitDelete(qNo) {
    location.href = "/courseQuestionDelete?courseQuestionNo=" + qNo;
}
</script>

</body>
</html>
