<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>수강신청 내역 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body { font-family: 'Pretendard', sans-serif; }

        /* 카드 */
        .card {
            background-color: #FFFFFF;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(30, 64, 175, 0.12);
            border: 1px solid #E5E7EB;
        }

        /* primary 버튼 */
        .btn-primary {
            background-color: #2563EB;
            color: white;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 2px 10px rgba(37, 99, 235, 0.3);
            transition: background .2s, transform .2s;
        }
        .btn-primary:hover {
            background-color: #1D4ED8;
            transform: scale(1.05);
        }

        /* Alert */
        .alert-blue {
            background-color: #DBEAFE;
            color: #1E40AF;
            border: 1px solid #BFDBFE;
            padding: 12px;
            border-radius: 8px;
        }

        /* 테이블 스타일 */
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            background-color: #EFF6FF;
            padding: 12px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            border-bottom: 2px solid #DBEAFE;
            color: #1E3A8A;
        }
        td {
            padding: 12px;
            font-size: 14px;
            border-bottom: 1px solid #E5E7EB;
        }
        tr:hover {
            background-color: rgba(37, 99, 235, 0.08);
        }
    </style>
</head>

<body class="bg-[#F5F7FA] text-gray-800">

{{> studentLayout/studentPageHeader }}

<main class="max-w-6xl mx-auto px-4 py-10">

    <div class="card">

        <!-- 제목 + 우측 상단 버튼 정렬 -->
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-bold text-gray-900 flex items-center gap-2">
                <i class="fa-solid fa-list-check text-blue-600"></i>
                수강신청 내역
            </h2>

            <a href="/courseListForEnrollment" class="btn-primary">
                <i class="fa-solid fa-plus"></i>
                수강신청 하러 가기
            </a>
        </div>

        <!-- 메시지 -->
        {{#message}}
        <div class="alert-blue mb-6">
            {{message}}
        </div>
        {{/message}}

        <!-- 테이블 -->
        <table>
            <thead>
            <tr>
                <th>강의명</th>
                <th>교수명</th>
                <th>학점</th>
                <th>요일</th>
                <th>교시</th>
                <th>신청일</th>
                <th class="text-center">취소</th>
            </tr>
            </thead>

            <tbody>
            {{#list}}
            <tr>
                <td>{{courseName}}</td>
                <td>{{professorName}}</td>
                <td>{{courseScore}}</td>
                <td>{{yoilName}}</td>
                <td>{{courseTimeStart}} ~ {{courseTimeEnd}}</td>
                <td>{{createdate}}</td>

                <td class="text-center">
                    <form method="post" action="/cancelEnrollment">
                        <input type="hidden" name="enrollmentNo" value="{{enrollmentNo}}">
                        <button class="btn-danger text-xs px-3 py-1 rounded bg-red-500 text-white hover:bg-red-600">
                            취소
                        </button>
                    </form>
                </td>
            </tr>
            {{/list}}

            {{^list}}
            <tr>
                <td colspan="7" class="py-6 text-center text-gray-500">
                    수강신청 내역이 없습니다.
                </td>
            </tr>
            {{/list}}
            </tbody>
        </table>

        <!-- 페이징 -->
        <div class="flex justify-center mt-8 gap-1 text-sm">

            {{#hasPrev}}
            <a href="?currentPage=1" class="px-3 py-2 border rounded bg-gray-100 hover:bg-gray-200">« 첫 페이지</a>
            <a href="?currentPage={{prevPage}}" class="px-3 py-2 border rounded bg-gray-100 hover:bg-gray-200">‹ 이전</a>
            {{/hasPrev}}

            {{#pageList}}
            <a href="?currentPage={{page}}"
               class="px-4 py-2 border rounded {{#current}}bg-blue-600 text-white font-bold{{/current}}">
                {{page}}
            </a>
            {{/pageList}}

            {{#hasNext}}
            <a href="?currentPage={{nextPage}}" class="px-3 py-2 border rounded bg-gray-100 hover:bg-gray-200">다음 ›</a>
            <a href="?currentPage={{lastPage}}" class="px-3 py-2 border rounded bg-gray-100 hover:bg-gray-200">마지막 »</a>
            {{/hasNext}}

        </div>

    </div>

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
