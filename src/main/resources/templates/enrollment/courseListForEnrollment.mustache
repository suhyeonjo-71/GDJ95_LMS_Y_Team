<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>수강신청 | 학사관리시스템</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
/* ============================================
   RESET & GLOBAL
============================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: 'Pretendard', 'Arial', sans-serif;
    background-color: #F5F7FA;
    color: #333;
    line-height: 1.6;
}

/* ============================================
   CARD — 고급형 Smart UI (Blue)
============================================ */
.card {
    background-color: #FFFFFF;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(30, 64, 175, 0.12); /* Blue shadow */
    transition: transform 0.3s ease;
}

/* ============================================
   BUTTON — Blue Smart UI
============================================ */
.btn-primary {
    background-color: #2563EB; /* blue-600 */
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    border: none;
    font-size: 15px;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(37, 99, 235, 0.3);
    transition: background-color .3s, transform .3s;
}
.btn-primary:hover {
    background-color: #1D4ED8; /* blue-700 */
    transform: scale(1.05);
}

/* Danger 버튼 */
.btn-danger {
    background-color: #EF4444;
    color: white;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
}
.btn-danger:hover {
    background-color: #DC2626;
}

/* ============================================
   ALERT — Blue 스타일
============================================ */
.alert-blue {
    background-color: #DBEAFE; /* blue-200 */
    color: #1E40AF;           /* blue-800 */
    border: 1px solid #BFDBFE; /* blue-300 */
    padding: 15px;
    border-radius: 8px;
    margin-top: 15px;
}

/* ============================================
   TABLE — Modern Blue Accent
============================================ */
.table-wrap {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
}
table {
    width: 100%;
    border-collapse: collapse;
}
th {
    background-color: #EFF6FF; /* blue-50 */
    color: #1E3A8A; /* blue-900 */
    padding: 12px;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid #DBEAFE; /* blue-200 */
}
td {
    padding: 12px;
    color: #374151;
    border-bottom: 1px solid #E5E7EB;
}
tr:hover {
    background-color: rgba(37, 99, 235, 0.10); /* blue-hover */
}

/* ============================================
   PAGINATION — Blue Theme
============================================ */
.pagination-area a {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    border: 1px solid #D1D5DB;
    background: #ffffff;
    margin: 0 3px;
}
.pagination-area a:hover {
    background-color: #2563EB;
    color: white;
    border-color: #2563EB;
}
.active-page {
    background-color: #2563EB !important;
    color: white !important;
    border-color: #2563EB !important;
}
.nav-btn {
    background-color: #E5EFFE; /* 연한 블루 */
}
.nav-btn:hover {
    background-color: #2563EB;
    color: white;
}
</style>

</head>

<body class="text-gray-800">

{{> studentLayout/studentPageHeader }}

<main class="max-w-6xl mx-auto px-4 py-10">

    <div class="card">

        <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2">
            <i class="fa-solid fa-book-open text-blue-600"></i>
            수강신청 가능 강의
        </h2>

        {{#message}}
        <div class="alert-blue mb-6">{{message}}</div>
        {{/message}}

        <!-- 검색 영역 -->
        <form method="get" class="mb-7 flex flex-wrap gap-4 items-end">

            <div>
                <label class="text-sm text-gray-700">요일</label>
                <select name="yoil" class="border rounded px-2 py-1 text-sm">
                    <option value="">전체</option>
                    <option value="1">월</option>
                    <option value="2">화</option>
                    <option value="3">수</option>
                    <option value="4">목</option>
                    <option value="5">금</option>
                </select>
            </div>

            <div>
                <label class="text-sm text-gray-700">교수명</label>
                <input type="text" name="professor" value="{{professor}}"
                       class="border rounded px-2 py-1 text-sm" placeholder="교수명 검색">
            </div>

            <div>
                <label class="text-sm text-gray-700">학과</label>
                <select name="deptCode" class="border rounded px-2 py-1 text-sm">
                    <option value="">전체</option>
                    {{#deptList}}
                    <option value="{{deptCode}}">{{deptName}}</option>
                    {{/deptList}}
                </select>
            </div>

            <button type="submit" class="btn-primary">검색</button>
        </form>

        <!-- 테이블 -->
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>강의명</th>
                    <th>교수명</th>
                    <th>학과</th>
                    <th>학점</th>
                    <th>요일</th>
                    <th>교시</th>
                    <th>정원(현재)</th>
                    <th class="text-center">신청</th>
                </tr>
                </thead>

                <tbody>
                {{#courseList}}
                <tr onclick="location.href='/studentCourseDetail?courseNo={{courseNo}}'">

                    <td>{{courseName}}</td>
                    <td>{{professorName}}</td>
                    <td>{{deptName}}</td>
                    <td>{{courseScore}}</td>
                    <td>{{yoilName}}</td>
                    <td>{{courseTimeStart}} ~ {{courseTimeEnd}}</td>
                    <td>{{courseCapacity}} / {{currentCount}}</td>

                    <td class="text-center">

                        {{#isFull}}
                        <span class="px-3 py-1 rounded bg-red-100 text-red-700 text-xs font-semibold">정원초과</span>
                        {{/isFull}}

                        {{^isFull}}
                        <form action="/addEnrollment" method="post" onclick="event.stopPropagation();">
                            <input type="hidden" name="courseNo" value="{{courseNo}}">
                            <button class="btn-primary text-xs px-3 py-1">신청</button>
                        </form>
                        {{/isFull}}

                    </td>

                </tr>
                {{/courseList}}

                {{^courseList}}
                <tr>
                    <td colspan="8" class="py-6 text-center text-gray-500 text-sm">
                        수강신청 가능한 강의가 없습니다.
                    </td>
                </tr>
                {{/courseList}}
                </tbody>
            </table>
        </div>

        <!-- 페이징 -->
        <div class="flex justify-center mt-8 pagination-area">

            {{#hasPrev}}
            <a class="nav-btn" href="?currentPage=1&yoil={{yoil}}&professor={{professor}}&deptCode={{deptCode}}">« 첫 페이지</a>
            <a class="nav-btn" href="?currentPage={{prevPage}}&yoil={{yoil}}&professor={{professor}}&deptCode={{deptCode}}">‹ 이전</a>
            {{/hasPrev}}

            {{#pageList}}
            <a href="?currentPage={{page}}&yoil={{yoil}}&professor={{professor}}&deptCode={{deptCode}}"
               class="{{#current}}active-page{{/current}}">
                {{page}}
            </a>
            {{/pageList}}

            {{#hasNext}}
            <a class="nav-btn" href="?currentPage={{nextPage}}&yoil={{yoil}}&professor={{professor}}&deptCode={{deptCode}}">다음 ›</a>
            <a class="nav-btn" href="?currentPage={{lastPage}}&yoil={{yoil}}&professor={{professor}}&deptCode={{deptCode}}">마지막 »</a>
            {{/hasNext}}

        </div>

    </div>

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
