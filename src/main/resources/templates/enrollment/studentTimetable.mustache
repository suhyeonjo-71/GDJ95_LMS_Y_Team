<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>내 시간표 | 학사관리시스템</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        /* ============================================
           RESET & GLOBAL
        ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #F5F7FA;
            color: #333;
        }

        /* ============================================
           CARD — 전체 박스
        ============================================ */
        .card {
            background-color: #FFFFFF;
            border-radius: 14px;
            padding: 30px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 4px 20px rgba(30, 64, 175, 0.12);
            transition: transform .3s ease;
        }
        .card:hover {
            transform: translateY(-3px);
        }

        /* 중심 정렬 */
        .timetable-wrapper {
            max-width: 900px;
            margin: 0 auto;
        }

        /* ============================================
           TABLE 
        ============================================ */
        .table-wrap {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #E5E7EB;
            margin-top: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
        }
        thead th {
            background-color: #EFF6FF;
            color: #1E3A8A;
            padding: 12px;
            font-weight: 600;
            border-bottom: 2px solid #DBEAFE;
        }

        .compact-cell {
            height: 65px !important;
        }

        tbody td {
            border: 1px solid #E5E7EB;
            padding: 0;
        }

        /* ============================================
           시간표 블록
        ============================================ */
        .timetable-block {
            width: 100%;
            height: 100%;
            background-color: #DBEAFE; /* blue-200 */
            color: #1E40AF;            /* blue-800 */
            border-radius: 10px;
            padding: 6px 4px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: background-color .2s ease;
        }
        .timetable-block:hover {
            background-color: #BFDBFE;
        }

        .timetable-name {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 2px;
            color: #1E3A8A;
        }
        .timetable-room {
            font-size: 11px;
            color: #475569;
        }
        .timetable-time {
            font-size: 11px;
            color: #64748B;
        }

    </style>
</head>

<body class="text-gray-800">

{{> studentLayout/studentPageHeader }}

<main class="max-w-6xl mx-auto px-4 py-10">

    <!-- 전체 박스(Card) 시작 -->
    <div class="card timetable-wrapper">

        <!-- 페이지 제목 -->
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <i class="fa-solid fa-calendar-days text-blue-600"></i>
                내 시간표
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                현재 학기 시간표입니다. 과목을 클릭하면 강의 상세 페이지로 이동합니다.
            </p>
        </div>

        <!-- 시간표 테이블 -->
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="w-20">교시</th>
                        <th>월</th>
                        <th>화</th>
                        <th>수</th>
                        <th>목</th>
                        <th>금</th>
                    </tr>
                </thead>

                <tbody>
                {{#periods}}
                <tr>

                    <!-- 교시 번호 -->
                    <td class="compact-cell bg-gray-50 font-semibold">
                        {{period}}
                    </td>

                    {{#yoils}}
                    <td class="compact-cell">

                        {{#timetable}}
                        <div class="timetable-block"
                             onclick="location.href='/studentCourseDetail?courseNo={{courseNo}}'">

                            <div class="timetable-name">{{courseName}}</div>
                            <div class="timetable-room">{{courseClassroom}}</div>
                            <div class="timetable-time">{{courseTimeStart}}교시 ~ {{courseTimeEnd}}교시</div>

                        </div>
                        {{/timetable}}

                        {{^timetable}}
                        <div style="width: 100%; height: 100%;"></div>
                        {{/timetable}}

                    </td>
                    {{/yoils}}

                </tr>
                {{/periods}}
                </tbody>
            </table>
        </div>

    </div>
    <!-- 전체 박스 끝 -->

</main>

{{> studentLayout/studentFooter }}

</body>
</html>
