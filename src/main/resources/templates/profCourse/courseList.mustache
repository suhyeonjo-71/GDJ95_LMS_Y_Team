<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>강의 관리</title>

    <link rel="stylesheet" as="style" crossorigin
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { 
	        font-family: Pretendard, sans-serif; 
	        background:#F5F7FA; 
        }

        .btn-primary { background-color: #2563EB; }
        .btn-primary:hover { background-color: #1D4ED8; }

        .divide-y tbody tr {
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
            cursor: pointer !important;
        }

        .divide-y tbody tr:hover {
            background-color: #F9FAFB !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08) !important;
        }

        /* 페이징 스타일 */
        .pagination-area a {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 13px;
            margin: 0 2px;
            transition: background-color .2s;
        }

        .pagination-area .page-btn { background: white; border: 1px solid #DFE3E8; }
        .pagination-area .page-btn:hover { background: #2563EB; color: white; }
        .pagination-area .active-page { background: #2563EB !important; color: white !important; font-weight: 600; }
        .pagination-area .nav-btn { background: #E8F0FE; }
        .pagination-area .nav-btn:hover { background: #2563EB; color:white; }
    </style>
</head>

<body class="text-gray-800">

    {{> profLayout/profHeader }}

    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">

        <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2 mb-4">
            <i class="fa-solid fa-chalkboard-user text-blue-600"></i> 강의 관리
        </h2>

        <div class="flex justify-between items-center">
        
            <form method="get" action="/courseList" class="flex gap-2 items-center">

			    <select name="year" id="year" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm">
				    <option value="" {{^year}}selected{{/year}}>년도 전체</option> 
				    
				    {{#yearOptions}}
				        <option value="{{value}}" {{#isSelected}}selected{{/isSelected}}>{{value}}년</option>
				    {{/yearOptions}}
				
				</select>
			
			    <select name="semester" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm">
			        <option value="">전체</option>
			        <option value="1" {{#selected.semester1}}selected{{/selected.semester1}}>1학기</option>
			        <option value="2" {{#selected.semester2}}selected{{/selected.semester2}}>2학기</option>
			    </select>
			
			    <select name="status" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm">
			        <option value="">전체</option>
			        <option value="1" {{#selected.status1}}selected{{/selected.status1}}>개설</option>
			        <option value="0" {{#selected.status0}}selected{{/selected.status0}}>종료</option>
			    </select>
			
			    <button type="submit"
			        class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition">검색</button>
			</form>
            
            <a href="/addCourse"
               class="bg-blue-600 text-white px-4 py-1.5 rounded-lg text-sm font-medium hover:bg-blue-700 transition shadow-md">
                <i class="fa-solid fa-plus mr-2"></i> 강의 등록
            </a>
        </div>


        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 border border-gray-200 rounded-lg">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">년도</th>
                            <th class="px-6 py-3 text-left text-xs font font-medium text-gray-500 uppercase tracking-wider">학기</th>
                            <th class="px-6 py-3 text-left text-xs font font-medium text-gray-500 uppercase tracking-wider">강의명</th>
                            <th class="px-6 py-3 text-left text-xs font font-medium text-gray-500 uppercase tracking-wider">요일 / 교시</th>
                            <th class="px-6 py-3 text-left text-xs font font-medium text-gray-500 uppercase tracking-wider">정원</th>
                            <th class="px-6 py-3 text-left text-xs font font-medium text-gray-500 uppercase tracking-wider">상태</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">관리</th>
                        </tr>
                    </thead>

                    <tbody class="bg-white divide-y divide-gray-200">
                        {{#list}}
                        <tr>
                            <td class="px-6 py-4 text-sm text-gray-700">{{courseYear}}</td>
                            <td class="px-6 py-4 text-sm text-gray-700">{{courseSemester}}</td>
                            <td class="px-6 py-4 text-sm font-medium">
                                <a href="/courseDashboard?courseNo={{courseNo}}" class="text-indigo-600 hover:text-indigo-900 font-medium">
                                    {{courseName}}
                                </a>
                            </td>
                            
                            <td class="px-6 py-4 text-sm text-gray-700">
                                {{#courseTimeYoil}}{{getYoilName}} / {{courseTimeStart}}~{{courseTimeEnd}}교시{{/courseTimeYoil}}
                                {{^courseTimeYoil}}-{{/courseTimeYoil}}
                            </td>
                            
                            <td class="px-6 py-4 text-sm text-gray-700">{{courseCapacity}}</td>
                            
                            <td class="px-6 py-4 text-sm">
                                {{#isOpened}}
                                	<span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                                		개설
                                	</span>
                                {{/isOpened}}
                                
                                {{#isClosed}}
	                                <span class="px-2 py-1 bg-gray-200 text-gray-500 rounded-full text-xs">
	                                종료
	                                </span>
                                {{/isClosed}}
                            </td>
                            <td class="px-6 py-4 text-sm text-center">
                                <a href="/removeCourse?courseNo={{courseNo}}"
                                   onclick="return confirm('정말 삭제할까요?');"
                                   class="text-red-600 hover:text-red-900 font-medium">삭제</a>
                            </td>
                        </tr>
                        {{/list}}

                        {{^list}}
                        <tr>
                            <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">
                                등록된 강의가 없습니다.
                            </td>
                        </tr>
                        {{/list}}
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between mt-6">
                <div class="flex justify-center pagination-area flex-grow">

                    {{#showPagination}}
                    {{#showPrev}}
                    <a href="/courseList?currentPage=1&year={{year}}&semester={{semester}}&status={{status}}" class="nav-btn">처음</a>
                    <a href="/courseList?currentPage={{prePage}}&year={{year}}&semester={{semester}}&status={{status}}" class="nav-btn">이전</a>
                    {{/showPrev}}
                    {{/showPagination}}

                    {{#pages}}
                        <a href="/courseList?currentPage={{.}}&year={{year}}&semester={{semester}}&status={{status}}"
                           class="page-btn {{#isCurrentPage}}active-page{{/isCurrentPage}}">
                            {{.}}
                        </a>
                    {{/pages}}

                    {{#showPagination}}
                    {{#showNext}}
                    <a href="/courseList?currentPage={{nextPage}}&year={{year}}&semester={{semester}}&status={{status}}" class="nav-btn">다음</a>
                    <a href="/courseList?currentPage={{lastPage}}&year={{year}}&semester={{semester}}&status={{status}}" class="nav-btn">끝</a>
                    {{/showNext}}
                    {{/showPagination}}
                </div>
            </div>

        </div>

    </main>

    {{> profLayout/profFooter }}

</body>
</html>