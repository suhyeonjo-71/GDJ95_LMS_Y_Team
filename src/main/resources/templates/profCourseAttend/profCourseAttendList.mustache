<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>출석 관리 - {{weekNo}}주차</title>

    <link rel="stylesheet" as="style" crossorigin 
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
          
    <style>
        body { 
            font-family: Pretendard, sans-serif; 
            background:#F5F7FA;
        }

        /* 테이블 hover (courseNoticeList 스타일 적용) */
        .divide-y tbody tr {
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
            cursor: default; /* 클릭 이벤트가 없으므로 default */
        }
        .divide-y tbody tr:hover {
            background-color: #F9FAFB !important;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08) !important;
        }
        
        /* 출석 저장 버튼 스타일 (courseNoticeList의 btn-primary 기반) */
        .btn-primary-save { 
            background-color: #2563EB; 
            transition: background-color 0.15s ease;
        }
        .btn-primary-save:hover { 
            background-color: #1D4ED8; 
        }

        /* 라디오 버튼 색상 (기존 유지) */
        .text-green-600:checked { border-color: #059669; background-color: #059669; }
        .text-red-600:checked { border-color: #DC2626; background-color: #DC2626; }
        .text-yellow-600:checked { border-color: #D97706; background-color: #D97706; }
    </style>
</head>

<body class="text-gray-800">

    {{> profLayout/profHeader }}

    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">

        <div class="flex justify-between items-center">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                <i class="fa-solid fa-calendar-check text-blue-600"></i>
                출석 관리 – {{weekNo}}주차
            </h2>
        </div>


        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">

            <form action="/saveCourseAttendList" method="post">

                <input type="hidden" name="courseNo" value="{{courseNo}}">
                <input type="hidden" name="weekNo" value="{{weekNo}}">

                <div class="overflow-x-auto border border-gray-200 rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left font-medium text-gray-600">이름</th>
                                <th class="px-6 py-3 text-left font-medium text-gray-600">학번</th>
                                <th class="px-6 py-3 text-left font-medium text-gray-600">학과</th>
                                <th class="px-6 py-3 text-left font-medium text-gray-600">연락처</th>
                                <th class="px-6 py-3 text-center font-medium text-gray-600">출석 상태</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-100">
                            {{#list}}
                            <tr>
                                <td class="px-6 py-3 whitespace-nowrap">{{studentName}}</td>
                                <td class="px-6 py-3 whitespace-nowrap">{{studentId}}</td>
                                <td class="px-6 py-3 whitespace-nowrap">{{deptName}}</td>
                                <td class="px-6 py-3 whitespace-nowrap">{{studentPhone}}</td>
                    
                                <td class="px-6 py-3 text-center">
                    
                                    <input type="hidden" name="studentUserNo" value="{{studentUserNo}}">
                    
                                    <div class="flex justify-center space-x-4">
                                        
                                        <label class="inline-flex items-center">
                                            <input type="radio"
                                                name="attendanceStatus_{{studentUserNo}}"
                                                value="0"
                                                {{#isAttend}}checked{{/isAttend}}
                                                class="form-radio text-green-600 h-4 w-4">
                                            <span class="ml-1 text-green-700 font-medium">출석</span>
                                        </label>
                                        
                                        <label class="inline-flex items-center">
                                            <input type="radio"
                                                name="attendanceStatus_{{studentUserNo}}"
                                                value="1"
                                                {{#isAbsent}}checked{{/isAbsent}}
                                                class="form-radio text-red-600 h-4 w-4">
                                            <span class="ml-1 text-red-700 font-medium">결석</span>
                                        </label>
                                        
                                        <label class="inline-flex items-center">
                                            <input type="radio"
                                                name="attendanceStatus_{{studentUserNo}}"
                                                value="2"
                                                {{#isLate}}checked{{/isLate}}
                                                class="form-radio text-yellow-600 h-4 w-4">
                                            <span class="ml-1 text-yellow-700 font-medium">지각</span>
                                        </label>
                                        
                                    </div>
                    
                                </td>
                            </tr>
                            {{/list}}

                            {{^list}}
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                    수강 중인 학생이 없습니다.
                                </td>
                            </tr>
                            {{/list}}
                        </tbody>
                    </table>
                </div>

                <div class="mt-8 flex justify-center space-x-3">

					<button type="submit"
						class="px-5 py-2 rounded-lg font-medium text-white btn-primary-save shadow-md">
						<i class="fa-solid fa-save mr-2"></i> 출석 저장
					</button>
					
					<div class="flex justify-end ml-4">
						<a href="/profCourseAttendWeekList?courseNo={{courseNo}}"
	                       class="px-4 py-2 bg-gray-400 text-white rounded-lg text-sm font-medium 
	                      			hover:bg-gray-500 transition shadow-md">
	                        <i class="fa-solid fa-list mr-1"></i> 목록으로
	                    </a>
                    </div>
                    
                </div>

            </form>

        </div>

    </main>

    {{> profLayout/profFooter }}

</body>
</html>