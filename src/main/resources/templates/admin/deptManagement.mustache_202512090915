        $deptForm[0].reset();
        $modalTitle.text("학과 등록");
        $modalSubtitle.text("* 표시는 필수 항목입니다");

        toggleInputState(false);

     	// FIX: 등록 버튼 표시 (flex 명시)
        $registerBtns.removeClass('hidden').addClass('flex'); 
        $detailBtns.addClass('hidden').removeClass('flex');
        $editBtns.addClass('hidden').removeClass('flex');

        $deptCrudModal.removeClass('hidden').addClass('flex');
