    window.enterDetailEditMode = function() {
        $modalTitle.text("학과 정보 수정");
        $modalSubtitle.text("정보를 수정 후 저장해주세요.");

        toggleInputState(false);

     	// editButtons를 보이고, 나머지 버튼은 숨깁니다.
        $editBtns.removeClass('hidden').addClass('flex'); 
        $detailBtns.addClass('hidden').removeClass('flex');
        $registerBtns.addClass('hidden').removeClass('flex');
    }

    window.cancelDetailEditMode = function() {
        bindFormData(originalDetailData);

        $modalTitle.text("학과 세부 정보 (" + originalDetailData.deptCode + ")");
        $modalSubtitle.text("학과 정보를 조회합니다. (변경 버튼을 눌러 수정 가능)");

        toggleInputState(true);

     	// FIX: 상세 버튼으로 돌아가기 (flex 명시)
        $detailBtns.removeClass('hidden').addClass('flex');
        $editBtns.addClass('hidden').removeClass('flex');
    }

    // 유틸리티 함수 (체크박스 상태)
    function updateRemoveButtonState() {
        const checkedCount = $('input[name="selectedDept"]:checked').length;
        $removeSelectedBtn.prop('disabled', checkedCount === 0);
    }

    // ------------------------
    // 💡 엑셀 기능 함수 (양식 다운로드)
    // ------------------------

    /**
     * 엑셀 양식 파일 다운로드 (GET 요청)
     */
    window.downloadDeptForm = function() {
        // 서버의 다운로드 엔드포인트로 리다이렉트
        window.location.href = '/admin/downloadDeptForm';
    };

    /**
     * 학과 목록 엑셀 다운로드 (다음 단계에서 구현)
     */
    window.downloadDeptList = function() {
        // ⭐️ 현재 검색 조건(currentSearchCondition)을 쿼리 파라미터로 전달 ⭐️
       const condition = currentSearchCondition;
       // URL 인코딩은 자바스크립트에서 처리하여 한글 깨짐 방지
       window.location.href = `/admin/downloadDeptList?searchDeptCondition=${encodeURIComponent(condition)}`;
    };

    // ------------------------
    // 모달 제어 함수 (일괄 업로드)
    // ------------------------

    window.openBatchUploadModal = function() {
        $deptUploadForm[0].reset();
        // input[type=file] 값을 초기화해야 드롭된 파일 정보도 제거됨
        $excelFile.val(''); 
        $fileNameDisplay.text('파일을 드래그하거나 클릭하여 업로드');
        $submitUploadBtn.prop('disabled', true);
        $batchUploadModal.removeClass('hidden').addClass('flex');
    }

    window.closeBatchUploadModal = function() {
        $batchUploadModal.removeClass('flex').addClass('hidden');
    }


    // ------------------------
    // 문서 로딩 완료 후 이벤트 리스너 설정
    // ------------------------
    $(document).ready(function() {

        renderPagination(initialTotalCount, currentPageNo);

        // 1. 페이징 링크 클릭 이벤트 위임
        $paginationDiv.on('click', '.page-link', function(e) {
            e.preventDefault();
            const targetPage = parseInt($(this).data('page'));

            if ($(this).hasClass('cursor-not-allowed')) return;

            searchAndRenderDept(targetPage);
        });

        // 2. 체크박스 이벤트 설정
        const $selectAll = $('#selectAll');

        $selectAll.on('change', function() {
            const isChecked = $(this).prop('checked');
            $('input[name="selectedDept"]').prop('checked', isChecked);
            updateRemoveButtonState();
        });

        $deptListBody.on('change', 'input[name="selectedDept"]', function() {
            updateRemoveButtonState();
            const $checkboxes = $('input[name="selectedDept"]');
            const allChecked = $checkboxes.length > 0 && $checkboxes.filter(':checked').length === $checkboxes.length;
            $selectAll.prop('checked', allChecked);
        });

        // 3. 폼 제출 이벤트 핸들링 (등록/수정)
        $deptForm.on('submit', function(e) {
            e.preventDefault();

            const isRegisterMode = !$registerBtns.hasClass('hidden');
            const url = isRegisterMode ? '/admin/insertDept' : '/admin/updateDept';

            let formData = {};

            if (isRegisterMode) {
                formData.deptCode = $newDeptCodeInput.val().trim();
                formData.deptName = $deptNameInput.val().trim();
            } else {
                formData.deptCode = $originalDeptCodeInput.val();
                formData.deptNewCode = $newDeptCodeInput.val().trim();
                formData.deptName = $deptNameInput.val().trim();
            }

            if ( !formData.deptCode || !formData.deptName || (!isRegisterMode && !formData.deptNewCode) ) {
                alert("필수 항목을 모두 입력해주세요.");
                return;
            }


            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    alert(response.message);
                    if (response.status === 'success') {
                        closeDeptCrudModal();
                    }
                },
                error: function() {
                    alert(isRegisterMode ? '학과 등록 중 서버 통신 오류가 발생했습니다.' : '학과 수정 중 서버 통신 오류가 발생했습니다.');
                }
            });
        });

        // 4. 검색 버튼 클릭 이벤트 처리
        $searchBtn.on('click', function() {
             searchAndRenderDept(1);
        });
        
    	 // ⭐️ 4-1. 검색 입력 필드 엔터 키 이벤트 처리 ⭐️
        $searchConditionInput.on('keyup', function(e) {
            // 엔터 키(KeyCode 13)가 눌렸는지 확인
            if (e.key === 'Enter') {
                searchAndRenderDept(1);
            }
        });

        // 5. 선택 항목 삭제 버튼 클릭 이벤트 처리
        $removeSelectedBtn.on('click', function() {
            const selectedDeptCodes = $('input[name="selectedDept"]:checked')
                .map(function() { return $(this).data('dept-code'); })
                .get();

            if(selectedDeptCodes.length === 0) {
                alert("삭제할 학과 코드를 선택해주세요.");
                return;
            }

            if(confirm(`선택된 ${selectedDeptCodes.length}개의 학과 코드를 정말 삭제 처리하시겠습니까?`)) {

                $.ajax({
                    url: '/admin/removeDept',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ deptCodeList: selectedDeptCodes }),
                    success: function(response) {
                        alert(response.message);
                        searchAndRenderDept(currentPageNo);
                    },
                    error: function() {
                        alert('학과 삭제 처리 중 서버 통신 오류가 발생했습니다.');
                    }
                });
            }
        });

        // 6. 엑셀 파일 선택/변경 이벤트 
        $excelFile.on('change', function() {
            const fileName = $(this).val().split('\\').pop();
            if (fileName) {
                $fileNameDisplay.text(fileName);
                $submitUploadBtn.prop('disabled', false);
            } else {
                $fileNameDisplay.text('파일을 드래그하거나 클릭하여 업로드');
                $submitUploadBtn.prop('disabled', true);
            }
        });

        // ⭐️ 9. 파일 선택 영역/버튼 클릭 시 input[type=file] 강제 실행 로직 (재조정) ⭐️
        $dropArea.on('click', function(e) {
            // 클릭된 요소가 input 자체가 아닐 때만 trigger를 실행하여 확실하게 팝업을 띄웁니다.
            // label의 기본 동작을 막지 않으므로, 환경에 따라 한 번 또는 두 번 팝업이 뜰 수 있지만,
            // 기능 불작동보다는 중복 팝업이 덜 치명적입니다.
            if (e.target.id !== 'excelFile') {
                $excelFile.trigger('click'); 
            }
        });

        // ⭐️ 10. 드래그 앤 드롭 이벤트 구현 (유지) ⭐️
        // dragenter, dragover: 파일이 영역 위로 들어왔을 때
        $dropArea.on('dragenter dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            // 시각적 피드백 제공 
            $(this).addClass('border-blue-600 bg-blue-50'); 
        });

        // dragleave: 파일이 영역을 벗어났을 때
        $dropArea.on('dragleave', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('border-blue-600 bg-blue-50');
        });

        // drop: 파일을 드롭했을 때
        $dropArea.on('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('border-blue-600 bg-blue-50');

            // 드롭된 파일 가져오기
            const files = e.originalEvent.dataTransfer.files;

            if (files.length > 0) {
                const file = files[0];
                const fileName = file.name;
                const fileExtension = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();

                // 파일 확장자 유효성 검사
                if (fileExtension === '.xlsx' || fileExtension === '.xls') {
                    // input[type=file] 요소에 드롭된 파일을 설정
                    $excelFile[0].files = files;

                    // change 이벤트를 수동으로 발생시켜 파일 이름 표시 및 버튼 활성화 로직 실행 (6번 항목)
                    $excelFile.trigger('change'); 
                } else {
                    alert("엑셀 파일(.xlsx, .xls)만 업로드 가능합니다.");
                    $excelFile.val(''); // input 값 초기화
                    $excelFile.trigger('change'); // 초기화 후 change 이벤트 재실행
                }
            }
        });

        // 7. 엑셀 일괄 업로드 폼 제출 처리 
        $deptUploadForm.on('submit', function(e) {
            e.preventDefault();

            if ($excelFile[0].files.length === 0) {
                alert('업로드할 엑셀 파일을 선택해주세요.');
                return;
            }

            const formData = new FormData(this);

            $submitUploadBtn.prop('disabled', true).text('업로드 중...');

            $.ajax({
                url: '/admin/uploadDeptBatch',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    alert(response.message);
                    if (response.status === 'success') {
                        closeBatchUploadModal();
                        searchAndRenderDept(1);
                    }
                },
                error: function(xhr) {
                    let errorMessage = '학과 일괄 업로드 중 서버 오류가 발생했습니다.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = `업로드 실패: ${xhr.responseJSON.message}`;
                    }
                    alert(errorMessage);
                },
                complete: function() {
                    $submitUploadBtn.prop('disabled', false).text('업로드');
                }
            });
        });

        // 8. 키보드 ESC로 모달 닫기 (CRUD 및 일괄 업로드 모달 통합)
        $(document).on('keydown', (e) => {
            if (e.key === 'Escape') {
                if ($deptCrudModal.hasClass('flex')) {
                    if (!$detailBtns.hasClass('hidden') || !$editBtns.hasClass('hidden')) {
                         cancelDetailEditMode();
                    }
                    closeDeptCrudModal();
                } else if ($batchUploadModal.hasClass('flex')) {
                     closeBatchUploadModal();
                }
            }
        });
        
     	// 맨 마지막에 이 한 줄 추가 또는 기존에 있으면 그대로 두기
        searchAndRenderDept(currentPageNo);
    });
</script>

