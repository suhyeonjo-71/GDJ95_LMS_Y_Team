<script>
	//날짜 포맷팅 헬퍼 함수 (T 제거 + 원하는 형식으로 변환)
	function formatDate(isoString) {
	    if (!isoString) return '-';
	
	    // "2025-12-02T11:48:15" 또는 "2025-12-02T11:48:15.123Z" 형태 모두 처리
	    const date = new Date(isoString);
	
	    // 한국식 날짜 형식으로 예쁘게 (예: 2025-12-02 11:48:15 또는 2025.12.02 11:48)
	    // 원하는 스타일에 따라 아래 두 줄 중 하나만 선택하세요!
	
	    // 1. 하이픈 + 띄어쓰기 (가장 일반적)
	    return date.toLocaleString('ko-KR', {
	        year: 'numeric',
	        month: '2-digit',
	        day: '2-digit',
	        hour: '2-digit',
	        minute: '2-digit',
	        second: '2-digit',
	        hour12: false
	    }).replace(/\.\s/g, '-').replace(/오[전후]\s/, ' '); // 필요시 오전/오후 제거
	
	    // 2. 점으로 구분 + 시간만 (좀 더 깔끔한 스타일 원하면 이거 추천)
	    // return `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
	}
</script>


<script>
    // 전역 변수 (DOM Element)
    const $deptCrudModal = $('#deptCrudModal');
    const $deptForm = $('#deptForm');
    const $modalTitle = $('#modalTitle');
    const $modalSubtitle = $('#modalSubtitle');

    const $registerBtns = $('#registerButtons');
    const $detailBtns = $('#detailButtons');
    const $editBtns = $('#editButtons');

    // Hidden Fields
    const $originalDeptCodeInput = $('#originalDeptCode');

    // Input Fields
    const $newDeptCodeInput = $('#newDeptCode');
    const $deptNameInput = $('#deptName');

    // List/Search Elements
    const $deptListBody = $('#deptListBody');
    const $searchConditionInput = $('#searchCondition');
    const $searchBtn = $('#searchBtn');
    const $removeSelectedBtn = $('#removeSelectedBtn');
    const $totalCountDisplay = $('#totalCountDisplay');
    const $paginationDiv = $('#pagination');

    // ⭐️ 엑셀 업로드 관련 DOM 변수 ⭐️
    const $batchUploadModal = $('#batchUploadModal');
    const $deptUploadForm = $('#deptUploadForm');
    const $excelFile = $('#excelFile');
    const $fileNameDisplay = $('#fileNameDisplay');
    const $submitUploadBtn = $('#submitUploadBtn');
    
    // ⭐️ 파일 드롭 영역으로 사용할 라벨 선택 ⭐️
    const $dropArea = $('label[for="excelFile"]'); 

    // [상태 관리 변수]
    let originalDetailData = {}; // 상세 조회 시 원본 데이터 저장용
    let currentSearchCondition = $searchConditionInput.val().trim() || '';
    let currentPageNo = {{currentPage}} || 1; // Mustache 템플릿의 초기 값 사용

    // **⭐️ 컨트롤러가 전달하는 초기 값 ⭐️**
    const initialTotalCount = {{totalCount}} || 0;

    // ------------------------
    // 유틸리티 함수: 폼 데이터 바인딩
    // ------------------------
    function bindFormData(data) {
        $originalDeptCodeInput.val(data.deptCode || '');
        $newDeptCodeInput.val(data.deptCode || '');
        $deptNameInput.val(data.deptName || '');
    }

    // ------------------------
    // 💡 입력 필드 상태 토글 (readonly / disabled)
    // ------------------------
    function toggleInputState(isReadOnly) {
        const $inputFields = $deptCrudModal.find('.input-field');

        $inputFields.each(function() {
            const $this = $(this);
            $this.prop('readOnly', isReadOnly);
            $this.prop('disabled', isReadOnly);

            if (isReadOnly) {
                $this.addClass('input-readonly');
            } else {
                $this.removeClass('input-readonly');
                $this.prop('disabled', false);
            }
        });
    }

    // ------------------------
    // 💡 학과 목록 테이블 렌더링
    // ------------------------
    function renderDeptTable(deptList) {
        let html = '';

        if (deptList && deptList.length > 0) {
            deptList.forEach((dept) => {
                const rownum = dept.rownum;

                html += `
                    <tr>
                        <td class="px-4 py-3 whitespace-nowrap text-center"><input type="checkbox" name="selectedDept" data-dept-code="${dept.deptCode}"></td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${rownum}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm font-medium">
                            <a href="#" onclick="openDeptDetailModal('${dept.deptCode}')" class="text-blue-600 hover:underline">
                                ${dept.deptCode}
                            </a>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-800">${dept.deptName}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${formatDate(dept.deptUpdatedate) || '-'}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${formatDate(dept.deptCreatedate)}</td>
                    </tr>
                `;
            });
        } else {
             html += `
                <tr>
                    <td colspan="6" class="px-4 py-3 whitespace-nowrap text-center text-gray-500">조회된 학과 정보가 없습니다.</td>
                </tr>
            `;
        }

        $deptListBody.html(html);

        $('#selectAll').prop('checked', false);
        updateRemoveButtonState();
    }


    // ------------------------
    // 💡 페이징 렌더링
    // ------------------------
    function renderPagination(totalCount, currentPage, pageSize = 10) {
        const totalPages = Math.ceil(totalCount / pageSize);

        $totalCountDisplay.text(`학과 목록 (총 ${totalCount}개의 학과)`);

        if (totalPages <= 1) {
            $paginationDiv.empty().hide();
            return;
        }

        let html = '<nav class="flex items-center space-x-1">';

        const pagesPerBlock = 10;
        const currentBlock = Math.floor((currentPage - 1) / pagesPerBlock);
        const blockStart = currentBlock * pagesPerBlock + 1;
        const blockEnd = Math.min(blockStart + pagesPerBlock - 1, totalPages);

        // 이전 페이지 버튼 (◀)
        const prevPage = currentPage - 1;
        const prevDisabled = (currentPage === 1) ? 'opacity-50 cursor-not-allowed' : '';
        html += `<a href="#" data-page="${prevPage > 0 ? prevPage : 1}"
                     class="page-link px-3 py-1 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-100 ${prevDisabled}">◀</a>`;

        // 페이지 번호 링크
        for (let i = blockStart; i <= blockEnd; i++) {
            const activeClass = (i === currentPage) ? 'bg-blue-600 text-white' : 'text-gray-700 hover:bg-gray-100';
            html += `<a href="#" data-page="${i}"
                       class="page-link px-3 py-1 text-sm font-medium rounded-lg ${activeClass}">${i}</a>`;
        }

        // 다음 페이지 버튼 (▶)
        const nextPage = currentPage + 1;
        const nextDisabled = (currentPage === totalPages) ? 'opacity-50 cursor-not-allowed' : '';
        html += `<a href="#" data-page="${nextPage <= totalPages ? nextPage : totalPages}"
                     class="page-link px-3 py-1 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-100 ${nextDisabled}">▶</a>`;


        html += '</nav>';

        $paginationDiv.html(html).show();
    }

    // ------------------------
    // 핵심 함수: 검색 및 페이지 이동 AJAX 요청
    // ------------------------
    function searchAndRenderDept(pageNo) {
        const condition = $searchConditionInput.val().trim();

        currentSearchCondition = condition;
        currentPageNo = pageNo;

        $.ajax({
            url: '/admin/searchDept',
            type: 'GET',
            data: {
                searchDeptCondition: condition,
                currentPage: pageNo
            },
            success: function(response) {
                if (response.status === 'success') {
                    renderDeptTable(response.searchDeptInfoList);
                    renderPagination(response.totalCount, response.currentPage);
                    $searchConditionInput.val(currentSearchCondition);
                } else {
                    alert('학과 검색에 실패했습니다.');
                }
            },
            error: function() {
                alert('서버 통신 오류가 발생했습니다.');
            }
        });
    }

    // ------------------------
    // 모달 제어 함수 (CRUD)
    // ------------------------

    window.closeDeptCrudModal = function() {
        $deptCrudModal.removeClass('flex').addClass('hidden');
        $deptForm[0].reset();
        $originalDeptCodeInput.val('');
        $searchConditionInput.val(currentSearchCondition);
        searchAndRenderDept(currentPageNo);
    }

