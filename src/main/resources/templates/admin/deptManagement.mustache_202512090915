                    $modalSubtitle.text("학과 정보를 조회합니다. (변경 버튼을 눌러 수정 가능)");

                    toggleInputState(true);

                    // FIX: 상세 버튼 표시 (flex 명시)
                    $detailBtns.removeClass('hidden').addClass('flex');
                    $registerBtns.addClass('hidden').removeClass('flex');
                    $editBtns.addClass('hidden').removeClass('flex');
                    $deptCrudModal.removeClass('hidden').addClass('flex');
                } else {
                    alert('학과 정보를 불러오는 데 실패했습니다: ' + response.message);
                }
            },
