                    <tr>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-10"><input type="checkbox" id="selectAll"></th>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-16">No</th>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-28">우선순위</th>
                        <th class="p-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">제목</th>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-24">작성자</th>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-24">조회수</th>
                        <th class="p-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-32">업데이트일자</th>
