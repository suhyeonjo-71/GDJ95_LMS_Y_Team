    function bindFormData(data) {
        originalAuthDetailCodeInput.value = data.authDetailCode || '';
        originalAuthCodeInput.value = data.authCode || '';
        
        newAuthDetailCodeInput.value = data.authDetailCode || '';
        authDetailNameInput.value = data.authDetailName || '';
        newAuthCodeInput.value = data.authCode || '';
        authNameInput.value = data.authName || '';
    }

    // ------------------------
    // 💡 입력 필드 읽기 전용 상태 토글
    // ------------------------
    function toggleInputReadOnly(isReadOnly) {
        inputFields.forEach(input => {
            input.readOnly = isReadOnly;
            input.disabled = isReadOnly;
            
            if (isReadOnly) {
                input.classList.add('input-readonly');
            } else {
                input.classList.remove('input-readonly');
            }
        });
        
        if (!isReadOnly) {
            newAuthDetailCodeInput.removeAttribute('disabled');
            newAuthCodeInput.removeAttribute('disabled');
        }
    }

    // ------------------------
    // 💡 사용자 권한 목록 테이블 렌더링
    // ------------------------
    function renderAuthTable(authList) {
        let html = '';
        
        if (authList && authList.length > 0) {
            authList.forEach((auth, index) => {
                const rownum = auth.rownum !== undefined ? auth.rownum : (index + 1); 
                
                html += `
                    <tr>
                        <td class="px-4 py-3 whitespace-nowrap text-center"><input type="checkbox" name="selectedAuth" data-auth-detail-code="${auth.authDetailCode}"></td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${rownum}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm font-medium">
                             <a href="#" onclick="openAuthDetailModal('${auth.authDetailCode}')" class="text-blue-600 hover:underline">
                                ${auth.authDetailCode}
                            </a>
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-800">${auth.authDetailName}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm font-medium">
                            ${auth.authCode}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-800">${auth.authName}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${formatDate(auth.authDetailUpdatedate) || '-'}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-center text-sm text-gray-500">${formatDate(auth.authDetailCreatedate)}</td>
                    </tr>
                `;
            });
        } else {
             html += `
                <tr>
                    <td colspan="8" class="px-4 py-3 whitespace-nowrap text-center text-gray-500">조회된 권한 정보가 없습니다.</td>
                </tr>
            `;
        }
        
        authListBody.innerHTML = html;
        
        const selectAll = document.getElementById('selectAll');
        if (selectAll) selectAll.checked = false;
        updateRemoveButtonState();
    }


    // ------------------------
    // 💡 페이징 렌더링
    // ------------------------
    function renderPagination(totalCount, currentPage, pageSize = 10) {
        const totalPages = Math.ceil(totalCount / pageSize);
        
        totalCountDisplay.textContent = `권한 목록 (총 ${totalCount}개의 권한)`;
        
        if (totalPages <= 1) {
            paginationDiv.innerHTML = '';
            paginationDiv.style.display = 'none';
            return;
        }

        let html = '<nav class="flex items-center space-x-1">';
        
        const pagesPerBlock = 10;
        const currentBlock = Math.floor((currentPage - 1) / pagesPerBlock);
        const blockStart = currentBlock * pagesPerBlock + 1;
        const blockEnd = Math.min(blockStart + pagesPerBlock - 1, totalPages);
        
        
        // 이전 페이지 버튼 (◀)
        const prevPage = currentPage - 1;
        const prevDisabled = (currentPage === 1) ? 'opacity-50 cursor-not-allowed' : '';
        html += `<a href="#" data-page="${prevPage > 0 ? prevPage : 1}" 
                     class="page-link px-3 py-1 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-100 ${prevDisabled}">◀</a>`;


        // 페이지 번호 링크 (블록 내)
        for (let i = blockStart; i <= blockEnd; i++) {
            const activeClass = (i === currentPage) ? 'bg-blue-600 text-white' : 'text-gray-700 hover:bg-gray-100';
            html += `<a href="#" data-page="${i}" 
                       class="page-link px-3 py-1 text-sm font-medium rounded-lg ${activeClass}">${i}</a>`;
        }

        // 다음 페이지 버튼 (▶)
        const nextPage = currentPage + 1;
        const nextDisabled = (currentPage === totalPages) ? 'opacity-50 cursor-not-allowed' : '';
        html += `<a href="#" data-page="${nextPage <= totalPages ? nextPage : totalPages}" 
                     class="page-link px-3 py-1 text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-100 ${nextDisabled}">▶</a>`;
        
        
        html += '</nav>';
        
        paginationDiv.innerHTML = html;
        paginationDiv.style.display = 'flex';
        
        // 이벤트 위임 (클릭 이벤트 처리)
        paginationDiv.querySelectorAll('.page-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                
                const clickedLink = e.target.closest('a.page-link');
                if (!clickedLink) return;

                const targetPage = parseInt(clickedLink.dataset.page);
                
                if (clickedLink.classList.contains('cursor-not-allowed') || targetPage < 1 || targetPage > totalPages) return;

                if (typeof searchAndRenderAuth === 'function') {
                    searchAndRenderAuth(targetPage); 
                } else {
                     console.error("searchAndRenderAuth 함수를 찾을 수 없습니다.");
                }
            });
        });
    }

    // ------------------------
    // 핵심 함수: 검색 및 페이지 이동 AJAX 요청
    // ------------------------
    function searchAndRenderAuth(pageNo) {
        const condition = searchConditionInput.value.trim();
        
        currentSearchCondition = condition; 
        currentPageNo = pageNo;
        
        $.ajax({
            url: '/admin/searchSysAuth', 
            type: 'GET',
            data: { 
                searchSysAuthCondition: condition, 
                currentPage: pageNo 
            },
            success: function(response) {
                if (response.status === 'success') {
                    renderAuthTable(response.authList);
                    renderPagination(response.totalCount, response.currentPage);
                    searchConditionInput.value = currentSearchCondition;
                } else {
                    alert('권한 검색에 실패했습니다.');
                }
            },
            error: function() {
                alert('서버 통신 오류가 발생했습니다.');
            }
        });
    }


    // ------------------------
    // 모달 제어 함수
    // ------------------------
    function openBatchUploadModal() {
        batchModal.classList.remove('hidden');
        batchModal.classList.add('flex');
    }

    function closeBatchUploadModal() {
        batchModal.classList.add('hidden');
        batchModal.classList.remove('flex');
        
        if (excelUploadForm) excelUploadForm.reset();
        if (fileNameDisplay) fileNameDisplay.textContent = '';
        if (uploadBtn) uploadBtn.setAttribute('disabled', 'disabled');
    }
    
    function closeAuthCrudModal() {
        authCrudModal.classList.add('hidden');
        authCrudModal.classList.remove('flex');
        authForm.reset();
        
        originalAuthDetailCodeInput.value = '';
        originalAuthCodeInput.value = '';
        
        searchConditionInput.value = currentSearchCondition; 
        searchAndRenderAuth(currentPageNo); 
    }

    function openRegisterModal() {
        // ⭐️ Null 체크 제거: 변수 ID를 HTML과 일치시켰으므로 이제 안전합니다. ⭐️
        
        authForm.reset();
        modalTitle.textContent = "권한 등록";
        modalSubtitle.textContent = "* 표시는 필수 항목입니다";
        
        toggleInputReadOnly(false); 
        
        // 등록 시에는 PK/FK 필드를 활성화 및 이름 통일
        newAuthDetailCodeInput.removeAttribute('readonly'); 
        newAuthDetailCodeInput.classList.remove('input-readonly');
        newAuthCodeInput.removeAttribute('readonly'); 
        newAuthCodeInput.classList.remove('input-readonly');
        
        registerBtns.classList.remove('hidden');
        detailBtns.classList.add('hidden');
        editBtns.classList.add('hidden');
        
        authCrudModal.classList.remove('hidden');
        authCrudModal.classList.add('flex');
    }

    function openAuthDetailModal(authDetailCode) {
        $.ajax({
            url: '/admin/getSysAuthDetail', 
            type: 'GET',
            data: { authDetailCode: authDetailCode },
            success: function(response) {
                if (response.status === 'success') {
                    const data = response.data;
                    originalDetailData = data; 
                    
                    bindFormData(data); 
                    
                    modalTitle.textContent = "권한 세부 정보 (" + authDetailCode + ")";
                    modalSubtitle.textContent = "권한 정보를 조회합니다. (변경 버튼을 눌러 수정 가능)";
                    
                    toggleInputReadOnly(true); 
                    
                    detailBtns.classList.remove('hidden');
                    registerBtns.classList.add('hidden');
                    editBtns.classList.add('hidden');
                    authCrudModal.classList.remove('hidden');
                    authCrudModal.classList.add('flex');
                } else {
                    alert('권한 정보를 불러오는 데 실패했습니다: ' + response.message);
                }
            },
            error: function() {
                alert('서버 통신 오류가 발생했습니다.');
            }
        });
    }

    function enterDetailEditMode() {
        modalTitle.textContent = "권한 정보 수정";
        modalSubtitle.textContent = "정보를 수정 후 저장해주세요.";
        
        toggleInputReadOnly(false); 
        
        editBtns.classList.remove('hidden');
        detailBtns.classList.add('hidden');
        registerBtns.classList.add('hidden');
        
        newAuthDetailCodeInput.removeAttribute('readonly');
        newAuthDetailCodeInput.classList.remove('input-readonly');
        newAuthCodeInput.removeAttribute('readonly');
        newAuthCodeInput.classList.remove('input-readonly');
    }

    function cancelDetailEditMode() {
        bindFormData(originalDetailData); 
        
        modalTitle.textContent = "권한 세부 정보 (" + originalDetailData.authDetailCode + ")";
        modalSubtitle.textContent = "권한 정보를 조회합니다. (변경 버튼을 눌러 수정 가능)";
        
        toggleInputReadOnly(true); 
        
        detailBtns.classList.remove('hidden');
        editBtns.classList.add('hidden');
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeBatchUploadModal();
            if(!authCrudModal.classList.contains('hidden')) {
                if (!detailBtns.classList.contains('hidden') || !editBtns.classList.contains('hidden')) {
                    cancelDetailEditMode();
                } 
                closeAuthCrudModal();
            }
        }
    });
    
    // 유틸리티 함수 (체크박스 상태)
    function updateRemoveButtonState() {
        const checkedCount = document.querySelectorAll('input[name="selectedAuth"]:checked').length;
        removeSelectedBtn.disabled = checkedCount === 0;
    }


    // ------------------------
    // DOMContentLoaded 이벤트 및 AJAX 요청
    // ------------------------
    document.addEventListener('DOMContentLoaded', () => {
        const selectAll = document.getElementById('selectAll');
        const removeBtn = document.getElementById('removeSelectedBtn'); 
        
        // ⭐️ 등록 버튼 클릭 이벤트 추가 (안전성 확보) ⭐️
        const openRegisterModalBtn = document.getElementById('openRegisterModalBtn'); 
        if (openRegisterModalBtn) {
            openRegisterModalBtn.addEventListener('click', openRegisterModal);
        }
        
        // 초기 로드 시 목록 조회
        if (typeof searchAndRenderAuth === 'function') {
            searchAndRenderAuth(currentPageNo); 
        }
        
        // 체크박스 이벤트 리스너 설정
        selectAll.addEventListener('change', (e) => {
            const isChecked = e.target.checked;
            document.querySelectorAll('input[name="selectedAuth"]').forEach(cb => {
                cb.checked = isChecked;
            });
            updateRemoveButtonState();
        });

        document.addEventListener('change', (e) => {
            if (e.target.name === 'selectedAuth') {
                updateRemoveButtonState();
                const allChecked = Array.from(document.querySelectorAll('input[name="selectedAuth"]')).every(cb => cb.checked);
                selectAll.checked = allChecked;
            }
        });
        
        // 1. 폼 제출 이벤트 핸들링 (등록/수정)
        authForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const isRegisterMode = registerBtns.classList.contains('hidden') === false;
            const url = isRegisterMode ? '/admin/insertSysAuth' : '/admin/updateSysAuth'; 

            let formData = {};

            if (isRegisterMode) {
                formData.authDetailCode = newAuthDetailCodeInput.value.trim();
                formData.authDetailName = authDetailNameInput.value.trim();
                formData.authCode = newAuthCodeInput.value.trim();
                formData.authName = authNameInput.value.trim();
            } else {
                formData.authDetailCode = originalAuthDetailCodeInput.value; 
                formData.authCode = originalAuthCodeInput.value;             
                
                formData.newAuthDetailCode = newAuthDetailCodeInput.value.trim(); 
                formData.authDetailName = authDetailNameInput.value.trim();
                formData.newAuthCode = newAuthCodeInput.value.trim();
                formData.authName = authNameInput.value.trim();
            }

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    alert(response.message);
                    if (response.status === 'success') {
                        closeAuthCrudModal(); 
                    }
                },
                error: function() {
                    alert(isRegisterMode ? '권한 등록 중 서버 통신 오류가 발생했습니다.' : '권한 수정 중 서버 통신 오류가 발생했습니다.');
                }
            });
        });
        
        // 2. 검색 버튼 클릭 이벤트 처리
        searchBtn.addEventListener('click', function() {
             searchAndRenderAuth(1); 
        });
        
     	// 검색 조건 입력 필드에서 Enter 키 입력 처리 (새로 추가된 부분)
        searchConditionInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault(); // 기본 폼 제출 동작 방지
                searchAndRenderAuth(1); // 첫 페이지로 검색 실행
            }
        });

        // 3. 선택 항목 삭제 버튼 클릭 이벤트 처리
        removeBtn.addEventListener('click', () => {
            const selectedAuthDetailCodes = Array.from(document.querySelectorAll('input[name="selectedAuth"]:checked'))
                .map(cb => cb.getAttribute('data-auth-detail-code')); 

            if(selectedAuthDetailCodes.length === 0) {
                alert("삭제할 권한 코드를 선택해주세요.");
                return;
            }

            if(confirm(`선택된 ${selectedAuthDetailCodes.length}개의 권한 코드를 정말 삭제 처리하시겠습니까?`)) {
                
                $.ajax({
                    url: '/admin/removeSysAuth', 
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ authDetailCodeList: selectedAuthDetailCodes }), 
                    success: function(response) {
                        alert(response.message);
                        searchAndRenderAuth(currentPageNo); 
                    },
                    error: function() {
                        alert('권한 삭제 처리 중 서버 통신 오류가 발생했습니다.');
                    }
                });
            }
        });
        
        // 4. 엑셀 양식 다운로드 버튼 이벤트 처리 (GET 요청)
        downloadFormBtn.addEventListener('click', function() {
            window.location.href = '/admin/downloadSysAuthForm';
        });

        // 5. 목록 엑셀 다운로드 버튼 클릭 이벤트 처리
        if (downloadListBtn) {
             downloadListBtn.addEventListener('click', function(e) {
                e.preventDefault(); 
                const downloadUrl = `/admin/downloadSysAuthList?searchSysAuthCondition=${encodeURIComponent(currentSearchCondition)}`;
                window.location.href = downloadUrl;
            });
        }

        // 6. 엑셀 파일 선택 이벤트: 파일명 표시 및 업로드 버튼 활성화
        excelFileInput.addEventListener('change', function() {
            if (this.files && this.files.length > 0) {
                const fileName = this.files[0].name;
                fileNameDisplay.textContent = `선택된 파일: ${fileName}`;
                uploadBtn.removeAttribute('disabled');
            } else {
                fileNameDisplay.textContent = '';
                uploadBtn.setAttribute('disabled', 'disabled');
            }
        });

        // 7. 엑셀 일괄 업로드 폼 제출 이벤트 처리 (POST 요청)
        excelUploadForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const file = excelFileInput.files[0];
            if (!file) {
                alert('업로드할 엑셀 파일을 선택해주세요.');
                return;
            }

            const formData = new FormData();
            formData.append('excelFile', file);
            
            uploadBtn.textContent = '업로드 중...';
            uploadBtn.setAttribute('disabled', 'disabled');

            $.ajax({
                url: '/admin/uploadSysAuthBatch', 
                type: 'POST',
                processData: false,     
                contentType: false,     
                data: formData,
                success: function(response) {
                    alert(response.message);
                    if (response.status === 'success') {
                        closeBatchUploadModal();
                    }
                },
                error: function() {
                    alert('서버 통신 오류가 발생했습니다.');
                },
                complete: function() {
                    uploadBtn.textContent = '업로드';
                    
                    excelUploadForm.reset();
                    fileNameDisplay.textContent = '';
                    uploadBtn.setAttribute('disabled', 'disabled');
                    
                    searchAndRenderAuth(currentPageNo); 
                }
            });
        });
    });
</script>
</body>
</html>