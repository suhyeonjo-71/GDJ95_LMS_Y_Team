<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>성적관리</title>
     <link rel="stylesheet" as="style" crossorigin
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>

    <style>
        body { 
            font-family: 'Pretendard', sans-serif; 
            background:#F5F7FA;
        }

        /* 등록 버튼 (courseNoticeList 스타일 적용) */
        .btn-primary { background-color: #2563EB; }
        .btn-primary:hover { background-color: #1D4ED8; }

        /* 테이블 hover (courseNoticeList 스타일 적용) */
        .divide-y tbody tr {
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
            cursor: default; /* 성적 목록은 클릭 이벤트가 없으므로 default */
        }
        .divide-y tbody tr:hover {
            background-color: #F9FAFB !important;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08) !important;
        }
        
        /* 페이징 공통 (courseNoticeList 스타일 적용 - 성적 관리에는 없으나 추후 사용 대비) */
        .pagination-area a {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 13px;
            margin: 0 2px;
            transition: background-color .2s;
        }

        /* 숫자 평상시 */
        .pagination-area .page-btn {
            background: white;
            border: 1px solid #DFE3E8;
        }

        /* 숫자 hover */
        .pagination-area .page-btn:hover {
            background: #2563EB;
            color: white;
        }

        /* 현재 페이지 */
        .pagination-area .active-page {
            background: #2563EB !important;
            color: white !important;
            font-weight: 600;
        }

        /* 처음 / 이전 / 다음 / 끝 버튼 */
        .pagination-area .nav-btn {
            background: #E8F0FE;
        }
        .pagination-area .nav-btn:hover {
            background: #2563EB;
            color: white;
        }
    </style>
</head>

<body class=" text-gray-800">

	{{> profLayout/profHeader }}
	
	<main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
	
	        <h2 class="text-xl font-bold mb-2 flex items-center gap-2"> <i class="fa-solid fa-chart-bar text-blue-600"></i>
			    성적 관리
			</h2>
	
	    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
	
	        <table class="min-w-full divide-y divide-gray-200">
	    
	            <thead class="bg-gray-50">
	                <tr>
	                    <th class="px-4 py-3 text-left text-xs font-bold text-gray-600">이름</th>
	                    <th class="px-4 py-3 text-left text-xs font-bold text-gray-600">학번</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">출석률</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">과제점수</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">시험점수</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">최종점수</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">등급</th>
	                    <th class="px-4 py-3 text-center text-xs font-bold text-gray-600">관리</th>
	                </tr>
	            </thead>
	
	            <tbody class="divide-y divide-gray-200">
	
	            {{#list}}
	            <tr>
	                <td class="px-4 py-3 text-sm">{{studentName}}</td>
	                <td class="px-4 py-3 text-sm">{{studentId}}</td>
	                <td class="px-4 py-3 text-center text-sm">{{attendanceRate}}%</td>
	                <td class="px-4 py-3 text-center text-sm">
	                	{{#assignmentScore}}{{assignmentScore}}{{/assignmentScore}}
   						{{^assignmentScore}}-{{/assignmentScore}}
	                </td>
	                <td class="px-4 py-3 text-center text-sm">
	        	 	    {{#examScore}}{{examScore}}{{/examScore}}
    					{{^examScore}}-{{/examScore}}
	                </td>
	                <td class="px-4 py-3 text-center text-sm font-bold">
	                	{{#finalScore}}{{finalScore}}{{/finalScore}}
    					{{^finalScore}}-{{/finalScore}}
    				</td>
					<td class="px-4 py-3 text-center text-sm font-bold">
						{{#gradeValue}}{{gradeValue}}{{/gradeValue}}
    					{{^gradeValue}}-{{/gradeValue}}
					</td>
	
	                <td class="px-4 py-3 text-center">
	                    <a href="/profCourseGradeForm?courseNo={{courseNo}}&studentUserNo={{studentUserNo}}"
	                       class="px-3 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700">
	                        성적입력
	                    </a>
	                </td>
	            </tr>
	            {{/list}}
	
	            {{^list}}
	            <tr>
	                <td colspan="8" class="py-6 text-center text-gray-400">
	                    등록된 학생이 없습니다.
	                </td>
	            </tr>
	            {{/list}}
	
	            </tbody>
	        </table>
            
            </div>
            
            <div class="flex items-center justify-between mt-6">
                <div class="flex justify-center pagination-area flex-grow">

                    {{#showPagination}}
                    {{#showPrev}}
                    <a href="/profCourseGradeList?courseNo={{courseNo}}&currentPage=1" class="nav-btn">처음</a>
                    <a href="/profCourseGradeList?courseNo={{courseNo}}&currentPage={{prePage}}" class="nav-btn">이전</a>
                    {{/showPrev}}
                    {{/showPagination}}

                    {{#pages}}
                        <a href="/profCourseGradeList?courseNo={{courseNo}}&currentPage={{.}}"
                           class="page-btn {{#isCurrentPage}}active-page{{/isCurrentPage}}">
                            {{.}}
                        </a>
                    {{/pages}}

                    {{#showPagination}}
                    {{#showNext}}
                    <a href="/profCourseGradeList?courseNo={{courseNo}}&currentPage={{nextPage}}" class="nav-btn">다음</a>
                    <a href="/profCourseGradeList?courseNo={{courseNo}}&currentPage={{lastPage}}" class="nav-btn">끝</a>
                    {{/showNext}}
                    {{/showPagination}}

                </div>
            </div>
        
	        <div class="flex justify-end ml-4">
				<a href="/courseDashboard?courseNo={{courseNo}}"
	               class="px-4 py-2 bg-gray-400 text-white rounded-lg text-sm font-medium 
	                      hover:bg-gray-500 transition shadow-md">
	                <i class="fa-solid fa-list mr-1"></i> 목록으로
	            </a>
			</div>
	</main>
	
	{{> profLayout/profFooter }}

</body>
</html>