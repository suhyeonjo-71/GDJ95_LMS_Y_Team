<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>성적 입력</title>
    
    <link rel="stylesheet" as="style" crossorigin 
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
          
    <style>
        body { 
            font-family: Pretendard, sans-serif; 
            background:#F5F7FA;
        }

        /* 저장 버튼 스타일 (courseNoticeList의 btn-primary 기반) */
        .btn-primary-save { 
            background-color: #2563EB; 
            transition: background-color 0.15s ease;
        }
        .btn-primary-save:hover { 
            background-color: #1D4ED8; 
        }

        /* 취소 버튼 스타일 */
        .btn-secondary {
            background-color: #F3F4F6;
            color: #4B5563;
            border: 1px solid #D1D5DB;
            transition: background-color 0.15s ease;
        }
        .btn-secondary:hover {
            background-color: #E5E7EB;
        }

        /* Input 필드 스타일 통일 */
        input[type="text"], input[type="number"] {
            padding: 8px 12px;
            border: 1px solid #D1D5DB;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        input[type="text"]:focus, input[type="number"]:focus {
            border-color: #60A5FA;
            ring: 3px;
            ring-color: #BFDBFE;
            outline: none;
        }
        
    </style>
</head>
<body class="text-gray-800">

	{{> profLayout/profHeader }}
	
	<main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
	    
	    <div class="flex justify-between items-center max-w-2xl mx-auto">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
			    <i class="fa-solid fa-graduation-cap text-blue-600"></i>
			    성적 입력
			</h2>
        </div>
        
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-2xl mx-auto space-y-6">
	        
	        <p class="text-sm text-gray-600 pb-4 border-b border-gray-200">
	            강의번호: {{courseNo}} / 학생번호: {{studentUserNo}}
	        </p>
	
	        <form action="/profCourseGradeForm" method="post" class="space-y-5">
	            <input type="hidden" name="courseNo" value="{{courseNo}}">
	            <input type="hidden" name="studentUserNo" value="{{studentUserNo}}">
	            <input type="hidden" name="attendanceRate" value="{{gradeData.attendanceRate}}">
	
	            <div>
	                <label class="block text-sm font-medium text-gray-700">출석률</label>
	                <input type="text"
	                       value="{{gradeData.attendanceRate}}%"
	                       class="mt-1 block w-full rounded-md border-gray-300 bg-gray-50 text-gray-500"
	                       readonly>
	            </div>
	
	            <div>
	                <label class="block text-sm font-medium text-gray-700">과제 점수 (0~100)</label>
	                <input type="number" name="assignmentScore"
	                       value="{{gradeData.assignmentScore}}"
	                       class="mt-1 block w-full rounded-md border-gray-300 bg-gray-50 text-gray-500"
	                       readonly>
	            </div>
	
	            <div>
	                <label class="block text-sm font-medium text-gray-700">시험 점수 (0~{{gradeData.examMaxScore}})</label>
	                <input type="number" name="examScore"
	                       value="{{gradeData.examScore}}"
	                       min="0" max="{{gradeData.examMaxScore}}" step="0.1"
	                       class="mt-1 block w-full rounded-md">
	            </div>
	
	            <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
	                <a href="/profCourseGradeList?courseNo={{courseNo}}"
	                   class="px-4 py-2 bg-gray-400 text-white rounded-lg text-sm font-medium 
                      hover:bg-gray-500 transition shadow-md">
	                    <i class="fa-solid fa-list mr-1"></i> 목록으로
	                </a>
	                <button type="submit"
	                        class="px-4 py-2 rounded text-white text-sm rounded-lg btn-primary-save font-medium">
	                    <i class="fa-solid fa-floppy-disk mr-1"></i> 저장 및 계산
	                </button>
	            </div>
	        </form>
	    </div>
	</main>
	
	{{> profLayout/profFooter }}

</body>
</html>